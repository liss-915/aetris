    function renderRecommendedItems(list){
      const now=Date.now();
      const windowMs=popularPeriod==='day'?86400000:popularPeriod==='week'?7*86400000:365*86400000;
      const periodHearts=communityHearts.filter(heart=>new Date(heart.created_at).getTime()>=now-windowMs);
      const items=[];
      communityPosts.forEach(post=>{
        const count=periodHearts.filter(heart=>heart.post_id===post.id).length;
        if(count>0)items.push({kind:'post',item:post,count,created_at:post.created_at});
      });
      communityComments.forEach(comment=>{
        const count=periodHearts.filter(heart=>heart.comment_id===comment.id).length;
        if(count>0)items.push({kind:'comment',item:comment,count,created_at:comment.created_at});
      });
      items.sort((a,b)=>b.count-a.count||new Date(b.created_at)-new Date(a.created_at));
      if(!items.length){const empty=document.createElement('div');empty.className='empty-state';const strong=document.createElement('strong');strong.textContent='Todavía no hay contenido';empty.append(strong);list.append(empty);return;}
      items.forEach(entry=>{
