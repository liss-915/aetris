        <h3 class="settings-section-title">Seguridad de tu cuenta</h3>
        <form id="password-form" class="settings-form">
          <label for="new-password">Nueva contraseña<input id="new-password" type="password" autocomplete="new-password" minlength="8" required placeholder="Mínimo 8 caracteres"></label>
          <label for="confirm-password">Confirmar nueva contraseña<input id="confirm-password" type="password" autocomplete="new-password" minlength="8" required placeholder="Repite la nueva contraseña"></label>
          <p class="settings-help">Usa una contraseña que no compartas con otras personas. Aetris nunca te pedirá que la envíes por mensajes.</p>
          <div class="data-actions"><button class="primary-button" id="save-password" type="submit">Actualizar contraseña</button></div>
          <p class="settings-status" id="password-status" role="status" aria-live="polite"></p>
        </form>
        <div class="panel" style="margin-top:18px;padding:15px"><strong>Sesión</strong><p class="settings-help">Puedes cerrar tu sesión desde el botón «Cerrar sesión» de la parte superior.</p></div>`;
      document.getElementById('password-form').addEventListener('submit', async event => {
        event.preventDefault();
        const password = document.getElementById('new-password').value;
        const confirmation = document.getElementById('confirm-password').value;
        const status = document.getElementById('password-status');
        const button = document.getElementById('save-password');
        if (password.length < 8) { status.textContent = 'La contraseña debe tener al menos 8 caracteres.'; return; }
        if (password !== confirmation) { status.textContent = 'Las contraseñas no coinciden.'; return; }
        button.disabled = true; status.textContent = 'Actualizando contraseña…';
        try {
          const { error } = await supabase.auth.updateUser({ password });
          if (error) throw error;
          document.getElementById('password-form').reset();
          status.textContent = 'Contraseña actualizada correctamente.';
        } catch (error) {
          status.textContent = 'No se pudo actualizar la contraseña: ' + (error?.message || 'Inténtalo nuevamente.');
        } finally { button.disabled = false; }
      });
    }
    function renderPreferencesSettings() {
      setSettingsTab('settings-preferences');
      const saved = readLocal('preferences');
      const prefs = saved && typeof saved === 'object' && !Array.isArray(saved) ? saved : {};
      settingsOutput.innerHTML = `
        <h3 class="settings-section-title">Preferencias de estudio</h3>
        <form id="preferences-form" class="settings-form">
          <label for="preferred-tool">Herramienta que prefieres usar<select id="preferred-tool"><option value="summary">Resumen</option><option value="cards">Tarjetas didácticas</option><option value="quiz">Quiz</option><option value="explain">Explicación</option><option value="exam">Examen de prueba</option></select></label>
          <label for="study-duration">Duración preferida de una sesión<select id="study-duration"><option value="15">15 minutos</option><option value="25">25 minutos</option><option value="45">45 minutos</option><option value="60">60 minutos</option></select></label>
          <p class="settings-help">Estas preferencias se guardan en este dispositivo y navegador. Por ahora sirven como referencia y no cambian automáticamente la generación de actividades.</p>
          <div class="data-actions"><button class="primary-button" type="submit">Guardar preferencias</button></div>
          <p class="settings-status" id="preferences-status" role="status" aria-live="polite"></p>
        </form>`;
      document.getElementById('preferred-tool').value = prefs.preferredTool || 'summary';
      document.getElementById('study-duration').value = String(prefs.studyDuration || 25);
      document.getElementById('preferences-form').addEventListener('submit', event => {
        event.preventDefault();
        writeLocal('preferences', { preferredTool: document.getElementById('preferred-tool').value, studyDuration: Number(document.getElementById('study-duration').value) });
        document.getElementById('preferences-status').textContent = 'Tus preferencias se guardaron en este dispositivo.';
      });
    }
    document.getElementById('settings-profile').addEventListener('click', renderProfileSettings);
    document.getElementById('settings-security').addEventListener('click', renderSecuritySettings);
    document.getElementById('settings-preferences').addEventListener('click', renderPreferencesSettings);
    document.getElementById('open-settings').addEventListener('click',()=>{document.getElementById('settings-panel').hidden=false;document.body.style.overflow='hidden';updateProfileSummary();document.getElementById('settings-admin').hidden=(currentUser?.email||'').toLowerCase()!==ADMIN_EMAIL;renderProfileSettings();document.getElementById('settings-panel').scrollTop=0;document.getElementById('close-settings').focus();});
    document.getElementById('close-settings').addEventListener('click',()=>{document.getElementById('settings-panel').hidden=true;document.body.style.overflow='';document.getElementById('open-settings').focus();});
    function renderStudyHistory() {
      setSettingsTab('settings-history');
      const output = document.getElementById('settings-output');
      const rawHistory = readLocal('history');
      const history = rawHistory.map((item, index) => {
        if (typeof item === 'string') return { id: `legacy_${index}`, tool: 'Actividad anterior', materialName: item, createdAt: '', content: '', legacy: true };
        return item;
      }).filter(Boolean);
      output.replaceChildren();

      const heading = document.createElement('div');
      heading.className = 'materials-heading';
      const headingText = document.createElement('div');
      const title = document.createElement('h3');
      title.textContent = `Historial de estudio (${history.length})`;
      const note = document.createElement('p');
      note.className = 'materials-note';
      note.textContent = 'Se guardan hasta 25 resultados en este dispositivo y en este navegador.';
      headingText.append(title, note);
      heading.append(headingText);
      if (history.length) {
        const clear = document.createElement('button');
        clear.type = 'button';
        clear.className = 'secondary-button';
        clear.textContent = 'Borrar historial';
        clear.addEventListener('click', () => {
          if (!confirm('¿Quieres borrar todo tu historial de estudio de este dispositivo?')) return;
          writeLocal('history', []);
          renderStudyHistory();
        });
        heading.append(clear);
      }
      output.append(heading);

      if (!history.length) {
        const empty = document.createElement('p');
        empty.className = 'empty-state';
        empty.textContent = 'Todavía no hay resultados guardados. Cuando generes un resumen, tarjetas o ejercicios desde un material, aparecerán aquí.';
        output.append(empty);
        return;
      }

      history.forEach(item => {
        const card = document.createElement('article');
        card.className = 'data-card';
        const info = document.createElement('div');
        const name = document.createElement('h3');
        const toolNames = { summary: 'Resumen', cards: 'Tarjetas didácticas', quiz: 'Quiz', exam: 'Examen de prueba', explain: 'Explicación' };
        name.textContent = `${toolNames[item.tool] || item.tool || 'Actividad'} · ${item.materialName || 'Material'}`;
        const date = document.createElement('small');
        date.textContent = item.createdAt ? new Date(item.createdAt).toLocaleString('es-PE') : 'Registro anterior';
        info.append(name, date);
        if (item.content) {
          const view = document.createElement('button');
          view.type = 'button';
          view.className = 'secondary-button';
          view.textContent = 'Ver contenido';
          view.addEventListener('click', () => {
            const existing = card.querySelector('.history-content');
            if (existing) { existing.remove(); view.textContent = 'Ver contenido'; return; }
            const content = document.createElement('p');
            content.className = 'history-content';
            content.style.cssText = 'white-space:pre-wrap;line-height:1.6;margin-top:12px;max-height:360px;overflow:auto;';
            content.textContent = item.content + (item.truncated ? '\n\n[El resultado se guardó parcialmente para cuidar el espacio de almacenamiento.]' : '');
            info.append(content);
            view.textContent = 'Ocultar contenido';
          });
          info.append(view);
        } else {
          const old = document.createElement('p');
          old.textContent = 'Este registro es de una versión anterior y no contiene el resultado completo.';
          info.append(old);
        }
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'secondary-button';
        remove.textContent = 'Eliminar';
        remove.addEventListener('click', () => {
          const current = readLocal('history');
          writeLocal('history', current.filter((entry, index) => {
            if (typeof entry === 'string') return `legacy_${index}` !== item.id;
            return entry?.id !== item.id;
          }));
          renderStudyHistory();
        });
        card.append(info, remove);
        output.append(card);
      });
    }
    document.getElementById('settings-history').addEventListener('click', renderStudyHistory);

    function renderAdminInbox() {
      const button = document.getElementById('settings-admin');
      if ((currentUser?.email || '').toLowerCase() !== ADMIN_EMAIL) {
        button.hidden = true;
        renderProfileSettings();
        return;
      }
      setSettingsTab('settings-admin');
      const output = document.getElementById('settings-output');
      output.replaceChildren();
      const heading = document.createElement('h3');
      heading.className = 'settings-section-title';
      heading.textContent = 'Bandeja privada de Aetris';
      const intro = document.createElement('p');
      intro.className = 'settings-help';
      intro.textContent = 'Mensajes enviados por los estudiantes. Solo la cuenta administradora puede consultar esta bandeja.';
      const refresh = document.createElement('button');
      refresh.type = 'button'; refresh.className = 'secondary-button'; refresh.textContent = 'Actualizar mensajes';
      const status = document.createElement('p'); status.className = 'settings-status'; status.setAttribute('role','status');
      const list = document.createElement('div'); list.style.cssText = 'display:grid;gap:12px;margin-top:14px;';
      output.append(heading,intro,refresh,status,list);
      async function loadMessages() {
        refresh.disabled = true; status.textContent = 'Cargando mensajes…'; list.replaceChildren();
        try {
          const { data, error } = await supabase.from('aetris_support_messages')
            .select('id,sender_email,message_type,message,created_at,status')
            .order('created_at',{ascending:false});
          if (error) throw error;
          if (!data || data.length === 0) {
            status.textContent = 'Todavía no hay mensajes recibidos.';
            return;
          }
          status.textContent = `Se encontraron ${data.length} mensaje(s).`;
          data.forEach(item => {
            const card = document.createElement('article');
            card.style.cssText = 'background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px;overflow-wrap:anywhere;';
            const title = document.createElement('strong');
            title.textContent = ({contacto:'Contacto',error:'Reporte de error',sugerencia:'Sugerencia'})[item.message_type] || 'Mensaje';
            const meta = document.createElement('p'); meta.className='settings-help';
            const date = item.created_at ? new Date(item.created_at).toLocaleString('es-PE') : 'Fecha no disponible';
            meta.textContent = `${item.sender_email || 'Correo no disponible'} · ${date} · Estado: ${item.status || 'nuevo'}`;
            const body = document.createElement('p'); body.style.cssText='white-space:pre-wrap;line-height:1.55;margin:10px 0 0;'; body.textContent=item.message || '';
            card.append(title,meta,body); list.append(card);
          });
        } catch (error) {
          console.error('Error al cargar la bandeja privada:',error);
          status.textContent = 'No se pudo cargar la bandeja. Comprueba que hayas iniciado sesión con merarimanyaneyra@gmail.com y que los permisos estén configurados.';
        } finally { refresh.disabled = false; }
      }
      refresh.addEventListener('click',loadMessages);
      loadMessages();
    }
    document.getElementById('settings-admin').addEventListener('click',renderAdminInbox);

    async function settingsMessage(kind,label){
      const v=prompt(label);
      if(!v?.trim())return;
      const output=document.getElementById('settings-output');
      output.textContent='Enviando tu mensaje…';
      try{
        const {data:{user},error:userError}=await supabase.auth.getUser();
        if(userError)throw userError;
        if(!user){output.textContent='Inicia sesión para enviar un mensaje al equipo de Aetris.';return;}
        const messageType=kind==='Contacto'?'contacto':kind==='Reporte de error'?'error':'sugerencia';
        const {error}=await supabase.from('aetris_support_messages').insert({
          user_id:user.id,
          sender_email:user.email||null,
          message_type:messageType,
          message:v.trim()
        });
        if(error)throw error;
        output.textContent='Tu mensaje se envió correctamente al equipo de Aetris. Gracias por ayudarnos a mejorar.';
      }catch(error){
        console.error('Error al enviar mensaje a Aetris:',error);
        output.textContent='No se pudo enviar el mensaje. Comprueba tu conexión e inténtalo nuevamente.';
      }
    }
    document.getElementById('settings-report').addEventListener('click',()=>settingsMessage('Reporte de error','Describe el error que encontraste:'));
    document.getElementById('settings-contact').addEventListener('click',()=>settingsMessage('Contacto','Escribe tu mensaje:'));
    document.getElementById('settings-suggest').addEventListener('click',()=>settingsMessage('Sugerencia de función','¿Qué función te gustaría que agreguemos?'));

    function refreshPersonalSections(){renderGoals();renderSchedule();renderCommunity();}
    refreshPersonalSections();

    showSection('inicio');
  </script>
</body>
</html>
