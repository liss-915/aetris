<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#eaf6fc">
  <title>Aetris | Apoyo escolar</title>
  <link rel="icon" type="image/png" href="data:image/png;base64,">
  <style>
    :root {
      --blue: #dff2fb;
      --blue-strong: #bfe6f7;
      --blue-deep: #397f9f;
      --ink: #202a30;
      --muted: #68777e;
      --line: #e7edf0;
      --surface: #ffffff;
      --page: #f8fbfc;
      --radius: 18px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--page);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      min-height: 100vh;
    }
    button { font: inherit; }
    .app-header {
      height: 76px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 max(22px, calc((100vw - 1120px) / 2));
    }
    .brand { display: flex; align-items: center; gap: 12px; }
    .logo-placeholder {
      width: 54px; height: 44px; display: grid; place-items: center;
      flex: 0 0 54px;
    }
    .logo-placeholder img, .auth-mark img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .brand-name { font-size: 20px; font-weight: 750; letter-spacing: -.5px; }
    .header-actions { display: flex; gap: 10px; }
    .icon-placeholder {
      width: 39px; height: 39px; border: 1px solid var(--line);
      border-radius: 50%; background: #fff; display: grid; place-items: center;
      color: #66767e; font-size: 16px;
    }
    .desktop-nav {
      background: #fff; border-bottom: 1px solid var(--line);
      display: flex; justify-content: center; gap: 8px; padding: 10px 18px;
    }
    .nav-button {
      border: 0; background: transparent; color: #65747b;
      padding: 10px 19px; border-radius: 13px; cursor: pointer;
      display: flex; align-items: center; gap: 9px; font-weight: 600;
      transition: background .18s ease, color .18s ease;
    }
    .nav-button:hover { background: #f2f8fa; }
    .nav-button.active { background: var(--blue); color: #245e78; }
    .nav-icon { font-size: 17px; line-height: 1; }
    main {
      width: min(100% - 40px, 1000px);
      margin: 0 auto; padding: 48px 0 70px; min-height: calc(100vh - 140px);
    }
    .screen { display: none; animation: appear .18s ease; }
    .screen.active { display: block; }
    @keyframes appear { from { opacity: .5; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
    h1 { font-size: clamp(27px, 4vw, 35px); letter-spacing: -.8px; margin: 0 0 9px; }
    h2 { font-size: 21px; margin: 0; letter-spacing: -.3px; }
    p { color: var(--muted); line-height: 1.6; }
    .intro { margin: 0 0 28px; max-width: 650px; }
    .home-screen {
      min-height: 56vh; display: flex; flex-direction: column;
      justify-content: center; align-items: flex-start; padding: 20px 5%;
    }
    .home-screen h1 { font-size: clamp(32px, 5vw, 46px); max-width: 650px; }
    .home-screen .welcome { font-size: 18px; margin: 4px 0 0; }
    .home-mark {
      width: 48px; height: 4px; border-radius: 10px; background: var(--blue-strong);
      margin-bottom: 24px;
    }
    .section-heading {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; margin-bottom: 24px;
    }
    .tool-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 38px;
    }
    .tool-card, .panel {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius); padding: 21px;
    }
    .tool-symbol {
      width: 42px; height: 42px; border-radius: 13px; background: #edf8fc;
      display: grid; place-items: center; font-size: 19px; margin-bottom: 16px;
    }
    .tool-card h3 { font-size: 16px; margin: 0 0 7px; }
    .tool-card p { font-size: 13px; margin: 0; }
    .materials-heading { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 15px; }
    .materials-note { margin: 0 0 17px; font-size: 14px; }
    .primary-button {
      border: 0; border-radius: 12px; padding: 11px 16px;
      background: var(--blue); color: #245e78; font-weight: 700; cursor: pointer;
    }
    .primary-button:hover { background: var(--blue-strong); }
    .visibility-options { display: flex; flex-wrap: wrap; gap: 9px; margin: 16px 0 20px; }
    .visibility-chip, .filter-chip {
      border: 1px solid #dce8ed; background: #fff; color: #596970;
      border-radius: 999px; padding: 8px 13px; font-size: 13px;
    }
    .empty-state {
      min-height: 145px; display: flex; flex-direction: column;
      align-items: center; justify-content: center; text-align: center;
      border: 1px dashed #d7e4e9; border-radius: 16px; padding: 22px;
      background: #fcfeff;
    }
    .empty-icon {
      width: 39px; height: 39px; display: grid; place-items: center;
      border-radius: 50%; background: #eff8fb; color: #6d9db2; margin-bottom: 10px;
    }
    .empty-state strong { font-size: 15px; font-weight: 650; }
    .empty-state p { font-size: 13px; margin: 6px 0 0; }
    .action-row { display: flex; justify-content: flex-end; margin-bottom: 18px; }
    .week-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 9px; margin: 18px 0; }
    .day {
      min-height: 112px; border: 1px solid var(--line); border-radius: 14px;
      background: #fff; padding: 13px 9px; text-align: center;
    }
    .day strong { display: block; font-size: 13px; }
    .day span { display: block; color: #a0adb2; font-size: 12px; margin-top: 17px; }
    .community-top { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 18px; }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
    .filter-chip { cursor: default; }
    .filter-chip.selected { background: var(--blue); border-color: var(--blue); color: #245e78; }
    .community-note { font-size: 13px; margin: 17px 2px 0; }

    .community-filter-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:10px 0 18px}
    .community-grade-label{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:650;color:var(--muted)}
    .community-grade-label select{border:1px solid var(--line);border-radius:999px;padding:9px 13px;background:#fff;color:var(--ink);font:inherit}
    .community-main-tabs .filter-chip,.community-filter-row .filter-chip,.popular-heading .filter-chip{cursor:pointer}
    .community-recommended-tools{background:#fff;border:1px solid var(--line);border-radius:16px;padding:15px;margin:12px 0 18px}
    .popular-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
    .recommended-comments{margin-top:22px;display:grid;gap:12px}
    .recommended-comments h2{font-size:18px;margin:0}
    .recommended-comment-card{border:1px solid var(--border-color);border-radius:16px;padding:14px;background:var(--card-bg, #fff);display:grid;gap:8px}
    .recommended-comment-meta{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:12px}
    .community-rules-action{margin-top:22px;display:flex;justify-content:flex-start}
    .popular-heading h2{font-size:18px;margin:0 0 3px}.popular-heading p{margin:0}
    .community-rules-content{padding:18px;overflow:auto}.community-rules-content h3{font-size:15px;margin:15px 0 6px}.community-rules-content p{color:var(--muted);line-height:1.55;margin:0 0 10px}.community-rules-content ul{margin:6px 0 12px;padding-left:22px;color:var(--muted);line-height:1.65}.community-rules-content li{margin:3px 0}
    .community-main-tabs .filter-chip{cursor:pointer}
    .community-heart{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--ink);padding:7px 12px;font:inherit;font-weight:700;cursor:pointer;min-height:36px}
    .community-heart .heart-symbol{font-size:17px;line-height:1;color:#6daecb}
    .community-heart[aria-pressed="true"]{background:#eaf7fc;border-color:#8bc8df;color:#245e78}
    .community-heart:disabled{opacity:.65;cursor:wait}
    .community-post-actions{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:10px}

    .mobile-nav { display: none; }



    .tool-card { cursor:pointer; transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease; }
    .tool-card:hover,.tool-card:focus { border-color:#b9ddeb; box-shadow:0 8px 22px rgba(57,127,159,.08); transform:translateY(-2px); outline:none; }
    .study-workspace { margin:-16px 0 34px; }
    .workspace-top { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
    .workspace-top h2 { margin:0; }
    .question-options { display:grid; gap:9px; margin:16px 0; }
    .answer-option { width:100%; text-align:left; padding:12px 14px; border:1px solid var(--line); background:#fff; color:var(--ink); border-radius:12px; cursor:pointer; }
    .answer-option:hover { border-color:#9dcfe2; background:#f7fcfe; }
    .answer-option:disabled { cursor:default; opacity:1; }
    .answer-option.correct { border-color:#72b99a; background:#effaf4; }
    .answer-option.incorrect { border-color:#e5a0a0; background:#fff4f4; }
    .progress-track { height:7px; background:#edf3f5; border-radius:99px; overflow:hidden; margin:12px 0 18px; }
    .progress-fill { height:100%; background:#8bc8e0; transition:width .2s ease; }
    .flashcard { min-height:170px; display:grid; place-items:center; text-align:center; padding:24px; background:#f4fbfe; border:1px solid #dceef5; border-radius:17px; cursor:pointer; font-size:19px; font-weight:650; }
    .flashcard small { display:block; color:var(--muted); font-size:12px; font-weight:500; margin-top:12px; }
    .stack-list { display:grid; gap:11px; }
    .data-card { background:#fff; border:1px solid var(--line); border-radius:14px; padding:15px 17px; display:flex; justify-content:space-between; gap:14px; align-items:flex-start; }
    .data-card h3 { margin:0 0 5px; font-size:15px; }
    .data-card p { margin:0; font-size:13px; white-space:pre-wrap; }
    .data-card small { color:var(--muted); }
    .data-actions { display:flex; gap:7px; flex-shrink:0; flex-wrap:wrap; }
    .data-card.done { opacity:.65; }
    .data-card.done h3 { text-decoration:line-through; }
    .goals-overview { border:1px solid var(--line); border-radius:16px; background:#f5fbfe; padding:18px; margin:0 0 18px; }
    .goals-overview-top { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; }
    .goals-overview strong { font-size:16px; }
    .goals-overview p { margin:5px 0 0; font-size:13px; }
    .goals-overview .progress-track { margin:13px 0 5px; }
    .goals-ideas { border:1px solid var(--line); border-radius:16px; padding:17px; margin:0 0 20px; }
    .goals-ideas h2 { margin:0 0 5px; font-size:16px; }
    .goals-ideas p { margin:0 0 12px; font-size:13px; }
    .goal-templates { display:flex; flex-wrap:wrap; gap:8px; }
    .goal-template { border:1px solid #dce8ed; border-radius:999px; background:#fff; color:var(--ink); padding:8px 12px; cursor:pointer; font-size:13px; }
    .goal-template:hover { background:var(--blue); }
    .goal-progress { min-width:190px; max-width:270px; margin-top:12px; }
    .goal-progress label { display:flex; justify-content:space-between; gap:8px; font-size:12px; color:var(--muted); }
    .goal-progress input { width:100%; accent-color:#8bc8e0; margin:8px 0 0; }
    .goal-card-main { flex:1; min-width:0; }
    .settings-panel { position:fixed; inset:0; z-index:3000; width:100%; height:100dvh; max-width:none; margin:0; padding:clamp(16px,3vw,26px); overflow-y:auto; overscroll-behavior:contain; border:0; border-radius:0; background:#f8fcfe; box-shadow:none; }
    .settings-panel[hidden] { display:none !important; }
    .nav-icon { display:inline-grid; place-items:center; width:26px; height:26px; border-radius:9px; background:#eaf6fc; color:#24333a; font-size:17px; font-weight:700; line-height:1; }
    .settings-panel .workspace-top { position:sticky; top:-1px; z-index:2; background:#f8fcfe; padding:6px 0 12px; }
    .settings-subtitle { margin:5px 0 0; font-size:14px; }
    .profile-summary { display:flex; align-items:center; gap:14px; padding:17px; margin:18px 0; border:1px solid var(--line); border-radius:16px; background:#fff; }
    .profile-avatar { width:54px; height:54px; flex:0 0 54px; display:grid; place-items:center; border-radius:50%; background:var(--blue); color:#202a30; font-size:22px; font-weight:800; }
    .profile-summary-text { display:flex; flex-direction:column; gap:4px; min-width:0; }
    .profile-summary-text strong { font-size:17px; }
    .profile-summary-text span { color:var(--muted); font-size:13px; overflow-wrap:anywhere; }
    .settings-tabs { display:flex; gap:8px; flex-wrap:wrap; border-bottom:1px solid var(--line); padding-bottom:12px; margin-bottom:16px; }
    .settings-tab { border:1px solid var(--line); background:#fff; color:var(--ink); border-radius:11px; padding:9px 14px; font-weight:650; cursor:pointer; }
    .settings-tab.active { background:var(--blue); border-color:var(--blue-strong); }
    .settings-form { max-width:720px; display:grid; gap:13px; }
    .settings-form label { display:grid; gap:6px; color:var(--ink); font-size:13px; font-weight:650; }
    .settings-form input, .settings-form select { width:100%; min-height:43px; border:1px solid #d7e4e9; border-radius:10px; padding:10px 12px; background:#fff; color:var(--ink); font:inherit; }
    .settings-form input:focus, .settings-form select:focus { outline:2px solid var(--blue-strong); outline-offset:1px; }
    .settings-help { font-size:13px; margin:0; }
    .settings-status { min-height:22px; font-size:13px; margin:0; }
    .settings-support-actions { margin-top:20px; padding-top:15px; border-top:1px solid var(--line); }
    .settings-section-title { margin:4px 0 12px; font-size:17px; }
    @media (max-width:680px) { .settings-panel { margin:10px; } .settings-tabs { gap:6px; } .settings-tab { padding:8px 10px; font-size:12px; } .profile-summary { padding:13px; } }
    .inline-form { display:grid; gap:10px; margin:14px 0; }
    .inline-form input,.inline-form textarea,.inline-form select { width:100%; border:1px solid #dce6ea; border-radius:10px; padding:11px 12px; font:inherit; background:#fff; color:var(--ink); }
    .inline-form textarea { min-height:84px; resize:vertical; }

    .schedule-editor,.community-composer { background:#fff; border:1px solid var(--line); border-radius:15px; padding:16px; margin:14px 0 18px; }
    .schedule-editor h3,.community-composer h3 { margin:0 0 12px; font-size:16px; }
    .schedule-form,.community-form { display:grid; gap:11px; }
    .schedule-form label,.community-form label { display:grid; gap:6px; font-size:13px; font-weight:650; }
    .schedule-form input,.community-form input,.community-form textarea,.community-form select { width:100%; min-height:43px; border:1px solid #dce6ea; border-radius:10px; padding:11px 12px; font:inherit; color:var(--ink); background:#fff; }
    .community-form textarea { min-height:110px; resize:vertical; }
    .schedule-form input:focus,.community-form input:focus,.community-form textarea:focus,.community-form select:focus { outline:2px solid var(--blue-strong); outline-offset:1px; }
    .calendar-toolbar { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:16px 0 10px; }
    .calendar-toolbar h2 { margin:0; font-size:19px; text-transform:capitalize; }
    .calendar-nav { display:grid; grid-template-columns:40px minmax(0,1fr) 40px; gap:10px; align-items:center; width:100%; }
    .calendar-nav h2 { margin:0; text-align:center; font-size:19px; text-transform:capitalize; }
    .calendar-nav button { border:1px solid #cfe5ef; border-radius:9px; background:#f4fbfe; color:var(--ink); min-height:38px; min-width:38px; padding:6px 10px; cursor:pointer; font-size:22px; line-height:1; }
    .calendar-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:6px; margin:10px 0 18px; }
    .calendar-weekday { text-align:center; font-size:12px; font-weight:700; color:var(--muted); padding:7px 2px; }
    .calendar-day { min-width:0; min-height:86px; text-align:left; border:1px solid var(--line); border-radius:10px; background:#fff; color:var(--ink); padding:7px; cursor:pointer; display:flex; flex-direction:column; gap:5px; }
    .calendar-day.outside-month { opacity:.48; }
    .calendar-day.selected { border:2px solid var(--blue-strong); background:#f1faff; }
    .calendar-day.today .calendar-day-number { color:#1678a5; font-weight:800; }
    .calendar-day-number { font-size:13px; font-weight:650; }
    .calendar-day-summary { font-size:10px; line-height:1.25; overflow-wrap:anywhere; color:var(--muted); }
    .calendar-day-count { font-size:10px; color:#245e78; font-weight:700; }
    .selected-date-heading { margin:18px 0 8px; font-size:16px; }
    .selected-date-actions { display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; }
    .community-post-meta { display:flex; flex-wrap:wrap; gap:8px; margin-top:9px; color:var(--muted); font-size:12px; }
    .community-post-body { white-space:pre-wrap; overflow-wrap:anywhere; margin-top:7px !important; }
    .community-attachments { display:grid; gap:8px; padding:12px; border:1px solid var(--line); border-radius:12px; background:#fbfdfe; }
    .attachment-label { font-size:13px; font-weight:700; }
    .attachment-help { margin:0; color:var(--muted); font-size:12px; line-height:1.45; }
    .attachment-actions { flex-wrap:wrap; }
    .post-attachment-preview { display:flex; align-items:center; gap:10px; flex-wrap:wrap; padding:8px; border-radius:10px; background:#f1faff; }
    .post-attachment-preview img { max-width:150px; max-height:120px; object-fit:contain; border-radius:8px; }
    .community-post-attachment { margin-top:12px; }
    .community-post-attachment img { display:block; max-width:min(100%,480px); max-height:360px; object-fit:contain; border-radius:12px; border:1px solid var(--line); }
    .community-post-attachment a { color:#176b91; overflow-wrap:anywhere; font-weight:650; }
    .community-status { min-height:20px; margin:8px 0; font-size:13px; color:#245e78; }
    .community-comments { margin-top:14px; padding-top:12px; border-top:1px solid var(--line); }
    .community-comment-list { display:grid; gap:10px; margin:10px 0; }
    .community-comment { border:1px solid var(--line); border-radius:11px; padding:11px; background:#fbfdfe; }
    .community-comment.reply { margin:8px 0 0 18px; background:#f3faff; }
    .community-comment-head { display:flex; align-items:center; flex-wrap:wrap; gap:7px; font-size:12px; color:var(--muted); }
    .community-comment-head strong { color:var(--ink); font-size:13px; }
    .community-comment-body { margin:7px 0 !important; white-space:pre-wrap; overflow-wrap:anywhere; font-size:14px; }
    .community-comment-form { display:grid; gap:8px; margin-top:10px; }
    .community-comment-form textarea { width:100%; min-height:68px; border:1px solid #dce6ea; border-radius:10px; padding:10px 12px; font:inherit; resize:vertical; }
    .community-comment-actions { display:flex; gap:8px; flex-wrap:wrap; }
    .community-comment-actions button { min-height:34px; }
    .community-replies { margin-top:8px; display:grid; gap:7px; }
    .community-reply-note { font-size:12px; color:var(--muted); margin:7px 0 0; }

    .community-thread-overlay { position:fixed; inset:0; z-index:1200; display:flex; align-items:center; justify-content:center; padding:14px; background:rgba(12,35,48,.48); }
    .community-thread-overlay[hidden] { display:none; }
    .community-thread-dialog { width:min(720px,100%); max-height:min(90vh,900px); display:flex; flex-direction:column; overflow:hidden; background:#fff; border:1px solid var(--line); border-radius:18px; box-shadow:0 18px 55px rgba(10,40,55,.22); }
    .community-thread-header { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:15px 17px; border-bottom:1px solid var(--line); background:#f1faff; }
    .community-thread-header h2 { margin:0; font-size:18px; }
    .community-thread-header button { flex:none; }
    .community-thread-post { padding:14px 17px; border-bottom:1px solid var(--line); background:#fff; }
    .community-thread-post h3 { margin:0 0 6px; font-size:16px; }
    .community-thread-post p { margin:0; white-space:pre-wrap; overflow-wrap:anywhere; }
    .community-thread-scroll { overflow:auto; padding:13px 17px; flex:1; min-height:100px; }
    .community-thread-compose { border-top:1px solid var(--line); padding:12px 17px max(12px,env(safe-area-inset-bottom)); background:#fff; }
