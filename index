    .community-comment-attachment img { display:block; max-width:min(100%,360px); max-height:260px; object-fit:contain; border:1px solid var(--line); border-radius:10px; }
    .community-comment-attachment a { color:#176b91; font-weight:650; overflow-wrap:anywhere; }
    .community-file-picker { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .community-file-name { font-size:12px; color:var(--muted); overflow-wrap:anywhere; }
