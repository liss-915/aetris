    .result-score { font-size:30px; font-weight:800; color:#397f9f; margin:10px 0; }
    .filter-chip { cursor:pointer; }
    .filter-chip:hover { border-color:#a9d6e7; }
    @media(max-width:680px) {
      .data-card { flex-direction:column; }
      .data-actions { width:100%; }
      .data-actions button { flex:1; }
      .workspace-top { align-items:flex-start; }
    }
    [hidden] { display: none !important; }
    .auth-screen { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; background: #f5fafc; }
    .auth-card { width: min(100%, 430px); background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 30px; box-shadow: 0 14px 40px rgba(36,94,120,.07); }
    .auth-brand { display:flex; align-items:center; gap:10px; font-size:20px; font-weight:750; margin-bottom:26px; }
    .auth-mark { width:52px; height:40px; display:grid; place-items:center; flex:0 0 38px; }
    .auth-card h1 { font-size:26px; }
    .auth-card > p { font-size:14px; margin:8px 0 20px; }
    .auth-tabs { display:grid; grid-template-columns:1fr 1fr; background:#f3f8fa; border-radius:12px; padding:4px; margin:20px 0; }
    .auth-tab { border:0; border-radius:9px; padding:10px 6px; background:transparent; color:#68777e; cursor:pointer; font-weight:650; }
    .auth-tab.active { background:#fff; color:#245e78; box-shadow:0 1px 4px #dce8ed; }
    .auth-card label { display:block; font-size:13px; font-weight:650; margin:14px 0 7px; }
    .auth-card input { width:100%; border:1px solid #dce6ea; border-radius:11px; padding:12px 13px; font:inherit; outline:none; }
    .auth-card input:focus { border-color:#91c9df; box-shadow:0 0 0 3px #e6f5fb; }
    .auth-submit { width:100%; margin-top:20px; padding:13px; }
    .auth-submit:disabled, .primary-button:disabled { opacity:.6; cursor:wait; }
    .auth-message { min-height:22px; font-size:13px !important; margin:13px 0 0 !important; }
    .privacy-note { font-size:12px !important; margin:14px 0 0 !important; }
    .account-email { max-width:210px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--muted); font-size:13px; }
    .sign-out-button, .secondary-button { border:1px solid var(--line); background:#fff; color:#50616a; border-radius:10px; padding:9px 12px; cursor:pointer; font-weight:600; }
    .materials-tools { display:grid; grid-template-columns:minmax(0,1fr) minmax(150px,190px) minmax(150px,190px); gap:9px; margin:12px 0; }
    .materials-tools input, .materials-tools select { width:100%; min-width:0; border:1px solid var(--line); border-radius:10px; padding:10px 12px; background:#fff; color:var(--ink); font:inherit; font-size:13px; }
    .materials-count { margin:0 0 10px; color:var(--muted); font-size:12px; }
    .material-type { display:inline-flex; width:max-content; border:1px solid var(--line); border-radius:999px; padding:3px 8px; color:var(--muted); font-size:11px; }
    @media (max-width:680px) { .materials-tools { grid-template-columns:1fr 1fr; } .materials-tools input { grid-column:1 / -1; } .material-item { align-items:flex-start; flex-direction:column; } .material-actions { flex-wrap:wrap; width:100%; } }
    .materials-list { display:grid; gap:10px; }
    .material-item { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:15px 17px; border:1px solid var(--line); border-radius:14px; background:#fff; }
    .material-details { min-width:0; display:grid; gap:5px; }
    .material-details strong { overflow-wrap:anywhere; font-size:14px; }
    .material-details span { color:var(--muted); font-size:12px; }
    .material-actions { display:flex; gap:7px; flex-shrink:0; }
    .secondary-button { font-size:12px; padding:8px 10px; }
    .visibility-chip.selected { background:var(--blue); border-color:var(--blue); color:#245e78; }
    .visibility-chip.disabled { color:#9aa6ab; background:#f8fafb; }
    @media (max-width: 680px) {
      .app-header { height: 66px; padding: 0 17px; }
      .account-email { display:none; }
      .sign-out-button { padding:8px 9px; font-size:12px; }
      .auth-card { padding:24px 20px; }
      .material-item { align-items:flex-start; flex-direction:column; }
      .material-actions { width:100%; }
      .material-actions button { flex:1; }
      .logo-placeholder { width: 36px; height: 36px; }
      .brand-name { font-size: 19px; }
      .desktop-nav { display: none; }
      main { width: min(100% - 34px, 560px); padding: 30px 0 112px; min-height: calc(100vh - 66px); }
      .home-screen { min-height: 62vh; padding: 10px 2px; }
      .home-screen .welcome { font-size: 16px; }
      .tool-grid { grid-template-columns: 1fr; gap: 11px; margin-bottom: 30px; }
      .tool-card { display: flex; align-items: center; gap: 14px; padding: 16px; }
      .tool-symbol { flex: 0 0 42px; margin: 0; }
      .tool-card p { margin-top: 4px; }
      .materials-heading { align-items: flex-start; flex-direction: column; }
      .materials-heading .primary-button { width: 100%; }
      .week-grid { grid-template-columns: repeat(2, 1fr); }
      .day:last-child { grid-column: 1 / -1; }
      .community-top { align-items: flex-start; flex-direction: column; }
      .community-top .primary-button { width: 100%; }
      .mobile-nav {
        display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px;
        position: fixed; z-index: 10; bottom: 0; left: 0; right: 0;
        padding: 8px 7px calc(8px + env(safe-area-inset-bottom));
        background: rgba(255,255,255,.97); border-top: 1px solid var(--line);
      }
      .mobile-nav .nav-button {
        flex-direction: column; justify-content: center; gap: 5px;
        padding: 8px 2px; border-radius: 12px; font-size: 10px;
      }
      .mobile-nav .nav-icon { font-size: 18px; }
    }
    @media (min-width: 681px) and (max-width: 850px) {
      main { width: min(100% - 48px, 760px); }
      .tool-grid { gap: 10px; }
      .tool-card { padding: 17px; }
    }

    /* Ajustes de navegación y bienvenida */
    .desktop-nav { display: none !important; }
    .mobile-nav {
      display: grid !important;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 6px;
      position: fixed;
      z-index: 30;
      left: 50%;
      right: auto;
      bottom: 0;
      transform: translateX(-50%);
      width: min(100%, 820px);
      padding: 9px 14px calc(9px + env(safe-area-inset-bottom));
      background: rgba(255,255,255,.98);
      border: 1px solid var(--line);
      border-bottom: 0;
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -5px 24px rgba(35,85,105,.07);
    }
    .mobile-nav .nav-button {
      min-width: 0;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      padding: 8px 4px;
      border-radius: 12px;
      font-size: 12px;
    }
    .mobile-nav .nav-icon { font-size: 19px; }
    main { padding-bottom: 118px !important; }
    .screen { display: none !important; }
    .screen.active { display: block !important; }
    .home-screen.active {
      display: flex !important;
      min-height: calc(100svh - 190px);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 30px 8px 24px;
    }
    .home-screen h1 { max-width: 720px; }
    .home-screen .welcome { max-width: 620px; }
    .mascot-area {
      width: min(100%, 390px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      margin: 24px auto 0;
    }
    .mascot-dialogue {
      position: relative;
      width: fit-content;
      max-width: 100%;
      padding: 13px 18px;
      border: 1.5px solid #b9ddeb;
      border-radius: 20px;
      background: #f3fbff;
      color: #315c70;
      font-size: 15px;
      font-weight: 650;
      line-height: 1.45;
      box-shadow: 0 5px 16px rgba(55,125,155,.07);
    }
    .mascot-dialogue::after {
      content: "";
      position: absolute;
      left: calc(50% - 8px);
      bottom: -9px;
      width: 15px;
      height: 15px;
      background: #f3fbff;
      border-right: 1.5px solid #b9ddeb;
      border-bottom: 1.5px solid #b9ddeb;
      transform: rotate(45deg);
    }
    .aetris-mascot {
      display: block;
      width: min(72%, 235px);
      height: auto;
      object-fit: contain;
      margin-top: 2px;
      mix-blend-mode: multiply;
    }
    .settings-icon-button {
      min-width: 40px;
      width: 40px;
      height: 40px;
      display: inline-grid;
      place-items: center;
      padding: 0;
      font-size: 19px;
    }
    @media (max-width: 680px) {
      .mobile-nav {
        left: 0;
        right: 0;
        width: 100%;
        transform: none;
        border-left: 0;
        border-right: 0;
        border-radius: 16px 16px 0 0;
        padding-left: 6px;
        padding-right: 6px;
      }
      .mobile-nav .nav-button { font-size: 10px; padding: 8px 2px; }
      main { padding-bottom: 112px !important; }
      .home-screen.active { min-height: calc(100svh - 180px); padding-top: 20px; }
      .home-screen h1 { font-size: clamp(29px, 8vw, 38px); }
      .mascot-area { width: min(100%, 330px); margin-top: 20px; }
      .aetris-mascot { width: min(68%, 205px); }
      .mascot-dialogue { font-size: 14px; }
    }

  </style>
</head>
<body>
  <section id="auth-screen" class="auth-screen">
    <div class="auth-card">
      <div class="auth-brand"><span class="auth-mark"><img src="data:image/png;base64," alt="Logo Aetris" style="width:100%;height:100%;object-fit:contain;display:block;"></span><span>Aetris</span></div>
      <h1 id="auth-title">Bienvenido a Aetris</h1>
      <p id="auth-description">Ingresa con tu cuenta para acceder a tu espacio de estudio.</p>
      <div class="auth-tabs">
        <button type="button" class="auth-tab active" id="show-login">Iniciar sesión</button>
        <button type="button" class="auth-tab" id="show-signup">Crear cuenta</button>
      </div>
      <form id="auth-form">
        <label for="auth-email">Correo electrónico</label>
        <input id="auth-email" type="email" autocomplete="email" required maxlength="254" placeholder="tucorreo@ejemplo.com">
        <label for="auth-password">Contraseña</label>
        <input id="auth-password" type="password" autocomplete="current-password" required minlength="8" placeholder="Mínimo 8 caracteres">
        <button class="primary-button auth-submit" id="auth-submit" type="submit">Iniciar sesión</button>
      </form>
      <p id="auth-message" class="auth-message" role="status" aria-live="polite"></p>
      <p class="privacy-note">Usa un correo al que tengas acceso. No compartas tu contraseña con otras personas.</p>
    </div>
  </section>

  <div id="app-shell" hidden>
  <header class="app-header">
    <div class="brand">
      <!-- Espacio reservado para incorporar el símbolo oficial de Aetris. -->
      <div class="logo-placeholder"><img src="data:image/png;base64," alt="Logo Aetris" style="width:100%;height:100%;object-fit:contain;display:block;"></div>
      <span class="brand-name">Aetris</span>
    </div>
    <div class="header-actions" aria-label="Cuenta">
      <span id="account-email" class="account-email"></span>
      <button id="open-settings" class="sign-out-button settings-icon-button" type="button" aria-label="Ajustes" title="Ajustes">⚙</button><button id="sign-out" class="sign-out-button" type="button">Cerrar sesión</button>
    </div>
  </header>

  <section id="settings-panel" class="panel settings-panel" hidden>
    <div class="workspace-top"><div><h2>Perfil y configuración</h2><p class="settings-subtitle">Administra tu información y tu cuenta de Aetris.</p></div><button id="close-settings" class="secondary-button" type="button">Cerrar</button></div>
    <div class="profile-summary">
      <div class="profile-avatar" id="profile-avatar" aria-hidden="true">A</div>
      <div class="profile-summary-text"><strong id="profile-display-name">Estudiante</strong><span id="profile-email-summary"></span></div>
    </div>
    <div class="settings-tabs" role="tablist" aria-label="Secciones de configuración">
      <button class="settings-tab active" id="settings-profile" type="button" role="tab" aria-selected="true">Mi perfil</button>
      <button class="settings-tab" id="settings-security" type="button" role="tab" aria-selected="false">Seguridad</button>
      <button class="settings-tab" id="settings-preferences" type="button" role="tab" aria-selected="false">Preferencias</button>
      <button class="settings-tab" id="settings-history" type="button" role="tab" aria-selected="false">Historial</button>
      <button class="settings-tab" id="settings-admin" type="button" role="tab" aria-selected="false" hidden>Administración</button>
    </div>
    <div class="data-actions settings-support-actions" style="flex-wrap:wrap">
      <button class="secondary-button" id="settings-report" type="button">Reportar un error</button>
      <button class="secondary-button" id="settings-contact" type="button">Contáctanos</button>
      <button class="secondary-button" id="settings-suggest" type="button">Sugerir una función</button>
    </div>
    <div id="settings-output" aria-live="polite"></div>
  </section>
  <nav class="desktop-nav" aria-label="Navegación principal">
    <button class="nav-button active" data-section="inicio" aria-current="page"><span class="nav-icon">⌂</span>Inicio</button>
    <button class="nav-button" data-section="estudio"><span class="nav-icon">▤</span>Estudio</button>
    <button class="nav-button" data-section="metas"><span class="nav-icon" aria-hidden="true">◎</span>Metas</button>
    <button class="nav-button" data-section="horario"><span class="nav-icon" aria-hidden="true">▦</span>Horario</button>
    <button class="nav-button" data-section="comunidad"><span class="nav-icon" aria-hidden="true">♧</span>Comunidad</button>
  </nav>

  <main>
    <section class="screen active home-screen" id="inicio" aria-labelledby="home-title">
      <div class="home-mark"></div>
      <h1 id="home-title">¡Hola! ¿Qué te gustaría aprender hoy?</h1>
      <p class="welcome">Bienvenido a Aetris, un espacio para acompañar tu aprendizaje.</p>
      <div class="mascot-area">
        <div class="mascot-dialogue" id="daily-motivation" role="status" aria-live="polite">Cada pequeño esfuerzo cuenta. ¡Hoy puedes avanzar un poco más!</div>
        <img class="aetris-mascot" src="data:image/png;base64," alt="Pequeña mascota negra de Aetris con ojos grandes">
      </div>
    </section>

    <section class="screen" id="estudio" aria-labelledby="study-title">
      <h1 id="study-title">Estudio</h1>
      <p class="intro">Explora herramientas para practicar, repasar y organizar tus materiales de aprendizaje.</p>
      <div class="tool-grid">
        <article class="tool-card" data-tool="quiz" tabindex="0" role="button" aria-label="Abrir Quiz">
          <div class="tool-symbol">✎</div>
          <div><h3>Quiz</h3><p>Pon a prueba lo que sabes con preguntas breves.</p></div>
        </article>
        <article class="tool-card" data-tool="exam" tabindex="0" role="button" aria-label="Abrir Examen de prueba">
          <div class="tool-symbol">▣</div>
          <div><h3>Examen de prueba</h3><p>Practica y repasa antes de una evaluación.</p></div>
        </article>
        <article class="tool-card" data-tool="cards" tabindex="0" role="button" aria-label="Abrir tarjetas didácticas">
          <div class="tool-symbol">▧</div>
          <div><h3>Tarjetas didácticas</h3><p>Repasa conceptos y recuerda información clave.</p></div>
        </article>
        <article class="tool-card" data-tool="summary" tabindex="0" role="button" aria-label="Crear resumen"><div class="tool-symbol">≡</div><div><h3>Resumen</h3><p>Organiza las ideas principales de tu material.</p></div></article>
        <article class="tool-card" data-tool="explain" tabindex="0" role="button" aria-label="Explicar material"><div class="tool-symbol">?</div><div><h3>Explicación</h3><p>Comprende el contenido con una explicación clara.</p></div></article>
      </div>
      <div id="study-workspace" class="panel study-workspace" hidden aria-live="polite"></div>

      <div class="materials-heading">
        <div><h2>Mis materiales</h2><p class="materials-note">Guarda PDF, imágenes, documentos y videos en tu espacio privado.</p></div>
        <div class="data-actions" style="flex-wrap:wrap"><button class="secondary-button" id="write-material" type="button">✎ Escribir material</button><button class="primary-button" id="choose-material" type="button">＋ Subir material</button></div>
        <input id="material-file" type="file" hidden accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.mp4,.webm,.mov">
      </div>
      <div class="visibility-options" aria-label="Visibilidad del material">
        <button class="visibility-chip selected" type="button" data-audience="privado">Solo para mí</button>
        <button class="visibility-chip" type="button" data-audience="grado">Para mi grado</button>
        <button class="visibility-chip" type="button" data-audience="todos">Para todos</button>
      </div>
      <p id="material-audience-help" class="materials-note">Solo tú podrás ver los materiales que subas con esta opción.</p>
      <div id="write-material-panel" class="panel" hidden style="margin:14px 0;padding:16px"><h3>Escribir o pegar apuntes</h3><input id="written-title" type="text" placeholder="Título del material" style="width:100%;margin:8px 0;padding:12px"><textarea id="written-content" rows="6" placeholder="Escribe o pega aquí tus apuntes…" style="width:100%;padding:12px;border:1px solid #cbdde7;border-radius:10px"></textarea><div class="data-actions"><button class="primary-button" id="save-written" type="button">Guardar material</button><button class="secondary-button" id="cancel-written" type="button">Cancelar</button></div></div>
      <p class="materials-note">Selecciona un material de tu lista antes de abrir Quiz, Examen o Flashcards.</p><p id="selected-material-label" class="materials-note">Ningún material seleccionado.</p>
      <p id="materials-message" class="materials-note" role="status" aria-live="polite">Tus archivos son privados y solo tú puedes consultarlos.</p>
      <div class="materials-tools" aria-label="Organizar materiales">
        <input id="materials-search" type="search" placeholder="Buscar por nombre…" aria-label="Buscar materiales por nombre">
        <select id="materials-type-filter" aria-label="Filtrar por tipo">
          <option value="all">Todos los tipos</option><option value="pdf">PDF</option><option value="image">Imágenes</option><option value="word">Word</option><option value="powerpoint">PowerPoint</option><option value="video">Videos</option><option value="text">Apuntes de texto</option><option value="other">Otros</option>
        </select>
        <select id="materials-sort" aria-label="Ordenar materiales">
          <option value="newest">Más recientes</option><option value="oldest">Más antiguos</option><option value="name">Nombre A-Z</option><option value="largest">Mayor tamaño</option>
        </select>
      </div>
      <p id="materials-count" class="materials-count" aria-live="polite"></p>
      <div id="materials-list" class="materials-list">
        <div class="empty-state" id="materials-empty">
          <div class="empty-icon">▤</div>
          <strong>Aún no has agregado materiales</strong>
          <p>Tus materiales aparecerán aquí cuando los agregues.</p>
        </div>
      </div>
    </section>

    <section class="screen" id="metas" aria-labelledby="goals-title">
      <div class="section-heading">
        <div><h1 id="goals-title">Metas</h1><p class="intro">Define objetivos de aprendizaje y lleva un seguimiento de tus avances.</p></div>
        <button class="primary-button" id="add-goal" type="button">＋ Agregar meta</button>
      </div>
      <div id="goals-overview" class="goals-overview" aria-live="polite"></div>
      <section class="goals-ideas" aria-label="Ideas para tus metas">
        <h2>Ideas para comenzar</h2>
        <p>Elige una sugerencia o crea una meta propia. Puedes avanzar poco a poco.</p>
        <div class="goal-templates">
          <button class="goal-template" type="button" data-goal-template="Repasar un tema|Leer mis apuntes y escribir las ideas principales.">Repasar un tema</button>
          <button class="goal-template" type="button" data-goal-template="Practicar ejercicios|Resolver algunos ejercicios y revisar mis respuestas.">Practicar ejercicios</button>
          <button class="goal-template" type="button" data-goal-template="Preparar una evaluación|Organizar los temas y practicar antes de la evaluación.">Preparar una evaluación</button>
          <button class="goal-template" type="button" data-goal-template="Leer cada semana|Dedicar un momento de la semana a la lectura.">Leer cada semana</button>
        </div>
      </section>
      <div id="goals-list" class="stack-list"></div>
    </section>

    <section class="screen" id="horario" aria-labelledby="schedule-title">
      <div class="section-heading">
        <div><h1 id="schedule-title">Horario</h1><p class="intro">Organiza tus clases y actividades por fecha durante todo el año.</p></div>
      </div>
      <div class="calendar-toolbar">
        <div class="calendar-nav"><button type="button" id="calendar-prev" aria-label="Mes anterior">‹</button><h2 id="calendar-month-title" aria-live="polite"></h2><button type="button" id="calendar-next" aria-label="Mes siguiente">›</button></div>
      </div>
      <div class="calendar-grid" id="week-grid" aria-label="Calendario anual por meses"></div>
      <div id="schedule-editor" class="schedule-editor" hidden>
        <h3 id="schedule-editor-title">Agregar actividad</h3>
        <form id="schedule-form" class="schedule-form">
          <label>Actividad o clase<input id="schedule-title-input" type="text" maxlength="100" placeholder="Ej. Matemática, estudiar, tareas…" required></label>
          <label>Fecha<input id="schedule-date-input" type="date" required></label>
          <label>Hora (opcional)<input id="schedule-time-input" type="time"></label>
          <div class="data-actions"><button class="primary-button" type="submit">Guardar actividad</button><button class="secondary-button" id="cancel-schedule" type="button">Cancelar</button></div>
          <p id="schedule-status" class="community-status" role="status" aria-live="polite"></p>
        </form>
      </div>
      <div class="selected-date-actions"><h3 class="selected-date-heading" id="selected-date-heading">Actividades de hoy</h3><button class="primary-button" type="button" id="add-selected-date">＋ Agregar actividad</button></div>
      <div id="schedule-list" class="stack-list"></div>
    </section>

    <section class="screen" id="comunidad" aria-labelledby="community-title">
      <h1 id="community-title">Comunidad</h1>
      <div class="community-top">
        <div class="filters community-main-tabs" aria-label="Secciones de comunidad">
          <button class="filter-chip selected" type="button" data-community-main="Recomendados">Recomendados</button>
          <button class="filter-chip" type="button" data-community-main="Estudio">Estudio</button>
          <button class="filter-chip" type="button" data-community-main="Social">Social</button>
        </div>
        <div class="data-actions" id="community-create-action"><button class="primary-button" id="add-post" type="button">＋ Crear publicación</button></div>
      </div>
      <div class="community-filter-row" id="community-filter-row">
        <label class="community-grade-label">Grado
