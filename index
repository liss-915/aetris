  <script type="module">
    import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.57.0/+esm';

    // La clave publishable es pública y está diseñada para usarse en el navegador.
    // Nunca coloques aquí una service_role key o una secret key.
    const SUPABASE_URL = 'https://vmguvpdiursdpoppwtwl.supabase.co';
    const SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_OkkKutkzJb4JOmfQkLZRDg_PNG_ejx1';
    const supabase = createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);

    const authScreen = document.getElementById('auth-screen');
    const appShell = document.getElementById('app-shell');
    const authForm = document.getElementById('auth-form');
    const authMessage = document.getElementById('auth-message');
    const authTitle = document.getElementById('auth-title');
    const authDescription = document.getElementById('auth-description');
    const authSubmit = document.getElementById('auth-submit');
    const passwordInput = document.getElementById('auth-password');
    let authMode = 'login';
    let currentUser = null;
    let communityRealtimeChannel = null;
    let communityRealtimeRefreshTimer = null;
    let communityRefreshPending = false;

    function setAuthMode(mode) {
      authMode = mode;
      const signingUp = mode === 'signup';
      document.getElementById('show-login').classList.toggle('active', !signingUp);
      document.getElementById('show-signup').classList.toggle('active', signingUp);
      authTitle.textContent = signingUp ? 'Crea tu cuenta' : 'Bienvenido a Aetris';
      authDescription.textContent = signingUp ? 'Regístrate con tu correo y una contraseña segura.' : 'Ingresa con tu cuenta para acceder a tu espacio de estudio.';
      authSubmit.textContent = signingUp ? 'Crear cuenta' : 'Iniciar sesión';
      passwordInput.autocomplete = signingUp ? 'new-password' : 'current-password';
      authMessage.textContent = '';
    }

    document.getElementById('show-login').addEventListener('click', () => setAuthMode('login'));
    document.getElementById('show-signup').addEventListener('click', () => setAuthMode('signup'));

    authForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = document.getElementById('auth-email').value.trim();
      const password = passwordInput.value;
      authSubmit.disabled = true;
      authMessage.textContent = authMode === 'signup' ? 'Creando tu cuenta…' : 'Verificando tus datos…';
      try {
        if (authMode === 'signup') {
          const { data, error } = await supabase.auth.signUp({
            email, password, options: { emailRedirectTo: window.location.href.split('#')[0] }
          });
          if (error) throw error;
          if (data.session) authMessage.textContent = 'Cuenta creada. Ingresando…';
          else authMessage.textContent = 'Cuenta creada. Revisa tu correo y confirma la dirección antes de iniciar sesión.';
        } else {
          const { error } = await supabase.auth.signInWithPassword({ email, password });
          if (error) throw error;
          authMessage.textContent = 'Sesión iniciada.';
        }
      } catch (error) {
        authMessage.textContent = friendlyAuthError(error);
      } finally {
        authSubmit.disabled = false;
      }
    });

    function friendlyAuthError(error) {
      const message = String(error?.message || 'Ocurrió un error.');
      if (/invalid login credentials/i.test(message)) return 'Correo o contraseña incorrectos.';
      if (/already registered/i.test(message)) return 'Ese correo ya tiene una cuenta. Inicia sesión.';
      if (/password should be at least/i.test(message)) return 'La contraseña debe tener al menos 8 caracteres.';
      if (/email not confirmed/i.test(message)) return 'Primero confirma tu correo desde el mensaje que te enviamos.';
      return message;
    }

    document.getElementById('sign-out').addEventListener('click', async () => {
      const { error } = await supabase.auth.signOut();
      if (error) alert('No se pudo cerrar sesión: ' + error.message);
    });

    function showApp(user) {
      currentUser = user;
      authScreen.hidden = Boolean(user);
      appShell.hidden = !user;
      if (user) {
        document.getElementById('account-email').textContent = user.email || '';
        updateProfileSummary(user);
        loadMaterials();
      }
      syncCommunityRealtime(Boolean(user));
    }

    supabase.auth.onAuthStateChange((_event, session) => {
      showApp(session?.user || null);
    });
    const { data: initialSession } = await supabase.auth.getSession();
    showApp(initialSession.session?.user || null);

    // Navegación local entre pantallas: no requiere cuentas, servidor ni conexión externa.
    const navigationButtons = document.querySelectorAll('.nav-button[data-section]');
    const screens = document.querySelectorAll('.screen');

    function showSection(sectionId) {
      // Mostrar únicamente la pantalla elegida.
      screens.forEach((screen) => {
        const isSelected = screen.id === sectionId;
        screen.classList.toggle('active', isSelected);
        screen.setAttribute('aria-hidden', String(!isSelected));
      });

      // Mantener sincronizados los estados de la navegación de escritorio y móvil.
      navigationButtons.forEach((button) => {
        const isSelected = button.dataset.section === sectionId;
        button.classList.toggle('active', isSelected);
        if (isSelected) button.setAttribute('aria-current', 'page');
        else button.removeAttribute('aria-current');
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (sectionId === 'comunidad' && currentUser) void loadCommunityPosts();
    }

    navigationButtons.forEach((button) => {
      button.addEventListener('click', () => showSection(button.dataset.section));
    });

    // La mascota comparte una frase distinta según el día de la semana.
    const dailyMotivation = document.getElementById('daily-motivation');
    const weekdayMessages = [
      'Comienza la semana con confianza: cada paso te acerca a lo que quieres lograr.',
      'Hoy es un buen día para descubrir algo nuevo. ¡Tu curiosidad te ayuda a crecer!',
      'No necesitas saberlo todo; solo seguir aprendiendo un poquito cada día.',
      'Tu esfuerzo de hoy construye los logros que celebrarás mañana.',
      '¡Ya avanzaste mucho esta semana! Sigue confiando en lo que puedes aprender.',
      'Aprender también puede ser divertido. Date tiempo para explorar y crear.',
      'Descansa, reconoce tus avances y prepárate para una nueva semana de aprendizajes.'
    ];
    if (dailyMotivation) {
      dailyMotivation.textContent = weekdayMessages[new Date().getDay()];
    }

    // Subida privada de archivos a Storage y registro de metadatos en public.materiales.
    const fileInput = document.getElementById('material-file');
    const materialMessage = document.getElementById('materials-message');
    const materialList = document.getElementById('materials-list');
    let selectedMaterialAudience='privado';
    const audienceHelp=document.getElementById('material-audience-help');
    document.querySelectorAll('[data-audience]').forEach(button=>button.addEventListener('click',()=>{
      const audience=button.dataset.audience;
      if(audience==='grado'&&!currentUser?.user_metadata?.grade){audienceHelp.textContent='Primero selecciona tu grado en Ajustes → Perfil para compartir con estudiantes de tu grado.';return;}
      selectedMaterialAudience=audience;
      document.querySelectorAll('[data-audience]').forEach(item=>item.classList.toggle('selected',item===button));
      audienceHelp.textContent=audience==='privado'?'Solo tú podrás ver los materiales que subas con esta opción.':audience==='grado'?`Los estudiantes de ${currentUser.user_metadata.grade} podrán ver este material.`:'Todos los estudiantes con sesión iniciada podrán ver este material.';
    }));
    const MAX_FILE_SIZE = 50 * 1024 * 1024;
    const allowedMimeTypes = new Set([
      'application/pdf','image/jpeg','image/png','image/gif','image/webp',
      'application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      'application/vnd.ms-powerpoint','application/vnd.openxmlformats-officedocument.presentationml.presentation',
      'application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
      'text/plain','video/mp4','video/webm','video/quicktime'
    ]);
    // Algunos navegadores Android no informan el MIME de ciertos videos; validar también por extensión.
    const allowedFileExtensions = new Set(['pdf','jpg','jpeg','png','gif','webp','doc','docx','ppt','pptx','xls','xlsx','txt','mp4','webm','mov']);
    document.getElementById('choose-material').addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file || !currentUser) return;
      if (file.size > MAX_FILE_SIZE) { materialMessage.textContent = 'El archivo supera el límite de 50 MB.'; fileInput.value = ''; return; }
      const fileExtension = (file.name.split('.').pop() || '').toLowerCase();
      if (!allowedMimeTypes.has(file.type) && !allowedFileExtensions.has(fileExtension)) { materialMessage.textContent = 'Este formato no está permitido. Elige PDF, imagen, documento o video compatible.'; fileInput.value = ''; return; }
      const safeName = file.name.normalize('NFKD').replace(/[^a-zA-Z0-9._-]/g, '_').slice(-100);
      const path = `${currentUser.id}/${crypto.randomUUID()}-${safeName}`;
      const button = document.getElementById('choose-material');
      button.disabled = true; materialMessage.textContent = 'Subiendo archivo…';
      try {
        const { error: uploadError } = await supabase.storage.from('materiales').upload(path, file, { upsert: false, contentType: file.type });
        if (uploadError) throw uploadError;
        const { error: rowError } = await supabase.from('materiales').insert({
          user_id: currentUser.id, nombre: file.name, ruta_archivo: path, tipo_mime: file.type, tamano_bytes: file.size, audiencia: selectedMaterialAudience, grado_destino: selectedMaterialAudience==='grado' ? (currentUser.user_metadata?.grade || null) : null
        });
        if (rowError) { await supabase.storage.from('materiales').remove([path]); throw rowError; }
        materialMessage.textContent = selectedMaterialAudience==='privado' ? 'Archivo guardado de forma privada.' : selectedMaterialAudience==='grado' ? 'Archivo compartido con estudiantes de tu mismo grado.' : 'Archivo compartido con todos los estudiantes.';
        await loadMaterials();
      } catch (error) {
        materialMessage.textContent = 'No se pudo subir el archivo: ' + error.message;
      } finally { button.disabled = false; fileInput.value = ''; }
    });

    document.getElementById('write-material').addEventListener('click',()=>{document.getElementById('write-material-panel').hidden=false;});
    document.getElementById('cancel-written').addEventListener('click',()=>{document.getElementById('write-material-panel').hidden=true;});
    document.getElementById('save-written').addEventListener('click',async()=>{
      const title=document.getElementById('written-title').value.trim()||'Apuntes escritos';
      const content=document.getElementById('written-content').value.trim();
      if(!content){materialMessage.textContent='Escribe tus apuntes antes de guardarlos.';return;}
      const file=new File([content],title.replace(/[\\/:*?"<>|]/g,'_')+'.txt',{type:'text/plain'});
      const safeName=file.name.normalize('NFKD').replace(/[^a-zA-Z0-9._-]/g,'_').slice(-100);
      const path=`${currentUser.id}/${crypto.randomUUID()}-${safeName}`;
      try{const {error:u}=await supabase.storage.from('materiales').upload(path,file,{upsert:false,contentType:'text/plain'});if(u)throw u;
        const {error:r}=await supabase.from('materiales').insert({user_id:currentUser.id,nombre:file.name,ruta_archivo:path,tipo_mime:'text/plain',tamano_bytes:file.size});if(r)throw r;
        document.getElementById('written-title').value='';document.getElementById('written-content').value='';document.getElementById('write-material-panel').hidden=true;materialMessage.textContent='Apuntes guardados.';await loadMaterials();
      }catch(e){materialMessage.textContent='No se pudieron guardar los apuntes: '+e.message;}
    });

    let materialsCache = [];
    const materialsSearch = document.getElementById('materials-search');
    const materialsTypeFilter = document.getElementById('materials-type-filter');
    const materialsSort = document.getElementById('materials-sort');
    const materialsCount = document.getElementById('materials-count');

    function getMaterialType(item) {
      const ext = (item.nombre?.split('.').pop() || '').toLowerCase();
      const mime = (item.tipo_mime || '').toLowerCase();
      if (ext === 'pdf' || mime.includes('pdf')) return 'pdf';
      if (['jpg','jpeg','png','gif','webp'].includes(ext) || mime.startsWith('image/')) return 'image';
      if (['doc','docx'].includes(ext) || mime.includes('word')) return 'word';
      if (['ppt','pptx'].includes(ext) || mime.includes('presentation') || mime.includes('powerpoint')) return 'powerpoint';
      if (['mp4','webm','mov'].includes(ext) || mime.startsWith('video/')) return 'video';
      if (['txt'].includes(ext) || mime.startsWith('text/')) return 'text';
      return 'other';
    }

    function renderMaterials() {
      materialList.replaceChildren();
      const query = (materialsSearch?.value || '').trim().toLocaleLowerCase('es');
      const type = materialsTypeFilter?.value || 'all';
      const sort = materialsSort?.value || 'newest';
      let visible = materialsCache.filter(item => {
        const matchesName = (item.nombre || '').toLocaleLowerCase('es').includes(query);
        const matchesType = type === 'all' || getMaterialType(item) === type;
        return matchesName && matchesType;
      });
      visible.sort((a,b) => {
        if (sort === 'oldest') return new Date(a.creado_en) - new Date(b.creado_en);
        if (sort === 'name') return (a.nombre || '').localeCompare(b.nombre || '', 'es', { sensitivity:'base' });
        if (sort === 'largest') return (b.tamano_bytes || 0) - (a.tamano_bytes || 0);
        return new Date(b.creado_en) - new Date(a.creado_en);
      });
      if (materialsCount) materialsCount.textContent = `${visible.length} de ${materialsCache.length} materiales`;
      if (!materialsCache.length) {
        const empty = document.createElement('div'); empty.className = 'empty-state';
        empty.innerHTML = '<div class="empty-icon">▤</div><strong>Aún no has agregado materiales</strong><p>Tus materiales aparecerán aquí cuando los agregues.</p>';
        materialList.append(empty); return;
      }
      if (!visible.length) {
        const empty = document.createElement('div'); empty.className = 'empty-state';
        empty.innerHTML = '<div class="empty-icon">⌕</div><strong>No se encontraron materiales</strong><p>Prueba con otro nombre o cambia el filtro.</p>';
        materialList.append(empty); return;
      }
      for (const item of visible) {
        const row = document.createElement('article'); row.className = 'material-item';
        const details = document.createElement('div'); details.className = 'material-details';
        const name = document.createElement('strong'); name.textContent = item.nombre;
        const typeLabel = document.createElement('span'); typeLabel.className = 'material-type';
        const labels = {pdf:'PDF',image:'Imagen',word:'Word',powerpoint:'PowerPoint',video:'Video',text:'Apuntes',other:'Archivo'};
        typeLabel.textContent = labels[getMaterialType(item)] || 'Archivo';
        const meta = document.createElement('span'); const audienceLabel=item.audiencia==='todos'?'Compartido con todos':item.audiencia==='grado'?`Compartido con ${item.grado_destino||'su grado'}`:'Privado'; meta.textContent = `${formatBytes(item.tamano_bytes)} · ${new Date(item.creado_en).toLocaleDateString('es-PE')} · ${audienceLabel}`;
        details.append(name, typeLabel, meta);
        const actions = document.createElement('div'); actions.className = 'material-actions';
        const open = document.createElement('button'); open.className = 'secondary-button'; open.textContent = 'Abrir';
        open.addEventListener('click', async () => {
          const { data: signed, error: signedError } = await supabase.storage.from('materiales').createSignedUrl(item.ruta_archivo, 60);
          if (signedError) { materialMessage.textContent = 'No se pudo abrir: ' + signedError.message; return; }
          window.open(signed.signedUrl, '_blank', 'noopener');
        });
        const remove = document.createElement('button'); remove.className = 'secondary-button'; remove.textContent = 'Eliminar';
        remove.addEventListener('click', async () => {
          if (!confirm(`¿Eliminar “${item.nombre}” de tus materiales?`)) return;
          remove.disabled = true;
          const { error: storageError } = await supabase.storage.from('materiales').remove([item.ruta_archivo]);
          if (storageError) { materialMessage.textContent = 'No se pudo eliminar el archivo: ' + storageError.message; remove.disabled = false; return; }
          const { error: dbError } = await supabase.from('materiales').delete().eq('id', item.id).eq('user_id', currentUser.id);
          if (dbError) { materialMessage.textContent = 'El archivo se quitó del almacenamiento, pero no se pudo actualizar el registro: ' + dbError.message; }
          else materialMessage.textContent = 'Material eliminado.';
          await loadMaterials();
        });
        const selectBtn = document.createElement('button'); selectBtn.className = 'primary-button'; selectBtn.textContent = selectedMaterial?.id === item.id ? 'Seleccionado ✓' : 'Usar para estudiar';
        selectBtn.addEventListener('click', () => { selectedMaterial = item; document.getElementById('selected-material-label').textContent = 'Material seleccionado: ' + item.nombre; renderMaterials(); });
        if(item.user_id===currentUser.id)actions.append(remove); actions.append(selectBtn, open); row.append(details, actions); materialList.append(row);
      }
    }

    async function loadMaterials() {
      if (!currentUser) return;
      const { data, error } = await supabase.from('materiales').select('id,user_id,nombre,ruta_archivo,tipo_mime,tamano_bytes,creado_en,audiencia,grado_destino').order('creado_en', { ascending: false });
      if (error) { materialMessage.textContent = 'No se pudieron cargar tus materiales: ' + error.message; return; }
      materialsCache = data || [];
      renderMaterials();
    }

    [materialsSearch, materialsTypeFilter, materialsSort].forEach(control => {
      control?.addEventListener('input', renderMaterials);
      control?.addEventListener('change', renderMaterials);
    });
    function formatBytes(bytes) {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }


    // Herramientas de estudio, metas, horario y comunidad.
    // Los datos de estas secciones se guardan localmente en el dispositivo.
    const localKey = (name) => `aetris_${name}_${currentUser?.id || 'guest'}`;
    const readLocal = (name) => { try { return JSON.parse(localStorage.getItem(localKey(name)) || '[]'); } catch { return []; } };
    const writeLocal = (name, value) => localStorage.setItem(localKey(name), JSON.stringify(value));
    const workspace = document.getElementById('study-workspace');
    let selectedMaterial = null;
    // Esta URL corresponde a la función desplegada en Supabase.
    const AI_FUNCTION_URL = 'https://vmguvpdiursdpoppwtwl.supabase.co/functions/v1/generar-estudio';
    const AI_MODE_BY_TOOL = {
      summary: 'summary',
      cards: 'flashcards',
      quiz: 'quiz',
      exam: 'exam',
      explain: 'explanation'
    };

    const questionBank = [
      {q:'¿Qué hábito ayuda a estudiar mejor?',a:['Estudiar sin descansos','Organizar el tiempo y hacer pausas','Dejar todo para el último día'],c:1,e:'Organizar el tiempo y descansar ayuda a mantener la concentración.'},
      {q:'¿Qué es una fuente confiable de información?',a:['Una publicación sin autor ni referencias','Una fuente identificable y verificable','Cualquier mensaje reenviado'],c:1,e:'Conviene revisar autoría, fecha y evidencias.'},
      {q:'¿Qué debes hacer antes de compartir una noticia?',a:['Verificarla en otras fuentes','Compartirla de inmediato','Cambiar el titular'],c:0,e:'Verificar evita difundir información falsa.'},
      {q:'¿Para qué sirve una meta de estudio?',a:['Para orientar el esfuerzo','Para evitar practicar','Para reemplazar el horario'],c:0,e:'Una meta clara permite enfocar y medir el avance.'},
      {q:'¿Qué estrategia favorece recordar conceptos?',a:['Leer una sola vez','Repasar activamente y espaciar los repasos','No volver a revisar'],c:1,e:'El repaso activo y espaciado fortalece la memoria.'},
      {q:'¿Qué es una idea principal?',a:['Un detalle secundario','La información central de un texto','Un ejemplo aislado'],c:1,e:'La idea principal resume lo más importante del texto.'},
      {q:'¿Qué unidad se usa para medir la masa?',a:['Metro','Kilogramo','Litro'],c:1,e:'El kilogramo es una unidad de masa.'},
      {q:'¿Cuál es el resultado de 8 × 7?',a:['54','56','64'],c:1,e:'Ocho multiplicado por siete es cincuenta y seis.'},
      {q:'¿Qué órgano bombea la sangre?',a:['Pulmón','Corazón','Estómago'],c:1,e:'El corazón impulsa la sangre por el cuerpo.'},
