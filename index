    function safeCommunityFileName(name){return String(name||'archivo').normalize('NFKD').replace(/[^a-zA-Z0-9._-]+/g,'_').replace(/^\.+/,'').slice(-90)||'archivo';}
    async function uploadCommunityAttachment(attachment){
      if(!attachment?.dataUrl)return null;
      const blob=await (await fetch(attachment.dataUrl)).blob();
      const path=`${currentUser.id}/${crypto.randomUUID()}/${safeCommunityFileName(attachment.name)}`;
      const {error}=await supabase.storage.from(COMMUNITY_BUCKET).upload(path,blob,{upsert:false,contentType:attachment.type||blob.type||'application/octet-stream',cacheControl:'3600'});
      if(error)throw error;
      return path;
    }
    async function uploadCommunityCommentAttachment(file){
      const path=`${currentUser.id}/comentarios/${crypto.randomUUID()}/${safeCommunityFileName(file.name)}`;
      const {error}=await supabase.storage.from(COMMUNITY_BUCKET).upload(path,file,{upsert:false,contentType:file.type||'application/octet-stream',cacheControl:'3600'});
      if(error)throw error;
      return path;
    }

    async function migrateLegacyCommunityPosts(){
      const marker=`aetris_community_legacy_migrated_${currentUser.id}`;
      if(localStorage.getItem(marker)==='1')return;
      const oldPosts=readLocal('posts');
      for(const oldPost of [...oldPosts].reverse()){
        if(!oldPost?.title||!oldPost?.body)continue;
        const legacyId=String(oldPost.id||`${oldPost.created||'legacy'}-${oldPost.title}`).slice(0,180);
        const {data:existing,error:checkError}=await supabase.from('comunidad_publicaciones').select('id').eq('user_id',currentUser.id).eq('legacy_id',legacyId).maybeSingle();
        if(checkError)throw checkError;
        if(existing)continue;
        let attachmentPath=null;
        try{
          if(oldPost.attachment?.dataUrl)attachmentPath=await uploadCommunityAttachment(oldPost.attachment);
          const metadata=currentUser?.user_metadata||{};
          const row={user_id:currentUser.id,author_name:String(oldPost.author||metadata.full_name||'Estudiante').slice(0,70),grade:metadata.grade||null,title:String(oldPost.title).slice(0,100),body:String(oldPost.body).slice(0,3000),category:oldPost.category==='Recursos'?'Social':oldPost.category==='Dudas'?'Estudio':(['Estudio','Social'].includes(oldPost.category)?oldPost.category:'Estudio'),subcategory:oldPost.category==='Dudas'?'Dudas':oldPost.category==='Recursos'?'Tema libre':null,attachment_path:attachmentPath,attachment_name:oldPost.attachment?.name||null,attachment_type:oldPost.attachment?.type||null,legacy_id:legacyId,created_at:oldPost.created||new Date().toISOString()};
          const {error:insertError}=await supabase.from('comunidad_publicaciones').insert(row);
          if(insertError){if(attachmentPath)await supabase.storage.from(COMMUNITY_BUCKET).remove([attachmentPath]);if(insertError.code==='23505')continue;throw insertError;}
        }catch(error){throw error;}
      }
      localStorage.setItem(marker,'1');
    }

    async function loadCommunityPosts(){
      if(!currentUser||communityLoading)return;
      communityLoading=true;setCommunityFeedStatus('Cargando publicaciones de la comunidad…');
      try{
        await migrateLegacyCommunityPosts();
        const {data,error}=await supabase.from('comunidad_publicaciones').select('id,user_id,author_name,grade,title,body,category,subcategory,attachment_path,attachment_name,attachment_type,created_at').order('created_at',{ascending:false}).limit(100);
        if(error)throw error;
        const postIds=(data||[]).map(post=>post.id);
        if(postIds.length){
          const {data:commentsData,error:commentsError}=await supabase.from('comunidad_comentarios').select('id,post_id,parent_comment_id,user_id,author_name,body,attachment_path,attachment_name,attachment_type,created_at').in('post_id',postIds).order('created_at',{ascending:true}).limit(1000);
          if(commentsError)throw commentsError;
          communityComments=await Promise.all((commentsData||[]).map(async comment=>{
            if(!comment.attachment_path)return comment;
            const {data:signed,error:signedError}=await supabase.storage.from(COMMUNITY_BUCKET).createSignedUrl(comment.attachment_path,3600);
            if(signedError){console.warn('No se pudo abrir un adjunto de comentario:',signedError.message);return {...comment,attachment_url:null};}
            return {...comment,attachment_url:signed?.signedUrl||null};
          }));
        }else{communityComments=[];}
        if(postIds.length){
          const {data:heartData,error:heartError}=await supabase.from('comunidad_corazones').select('id,user_id,post_id,comment_id,created_at').or(`post_id.in.(${postIds.join(',')}),comment_id.in.(${communityComments.map(c=>c.id).join(',')||'00000000-0000-0000-0000-000000000000'})`).limit(5000);
          if(heartError)throw heartError;communityHearts=heartData||[];
        }else{communityHearts=[];}
        communityPosts=await Promise.all((data||[]).map(async post=>{
          if(!post.attachment_path)return post;
          const {data:signed,error:signedError}=await supabase.storage.from(COMMUNITY_BUCKET).createSignedUrl(post.attachment_path,3600);
          if(signedError){console.warn('No se pudo abrir un adjunto de comunidad:',signedError.message);return {...post,attachment_url:null};}
          return {...post,attachment_url:signed?.signedUrl||null};
        }));
        renderCommunity();
        if(activeCommunityThreadPostId)renderCommunityThread();
        setCommunityFeedStatus('');
      }catch(error){
        console.error('Error al cargar la comunidad compartida:',error);
        setCommunityFeedStatus('No se pudieron cargar las publicaciones. Comprueba tu conexión e inténtalo de nuevo.');
      }finally{communityLoading=false;if(communityRefreshPending){communityRefreshPending=false;scheduleCommunityRefresh();}}
    }

