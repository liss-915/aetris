    ];
    let activeQuestions = [], questionIndex = 0, questionScore = 0, quizMode = 'quiz', cardIndex = 0, cardFlipped = false;
    const flashcards = [
      ['¿Qué es una célula?','La unidad básica estructural y funcional de los seres vivos.'],
      ['¿Qué es un ecosistema?','Conjunto de seres vivos y el medio físico con el que interactúan.'],
      ['¿Qué es una fracción?','Una forma de representar partes iguales de un todo.'],
      ['¿Qué es la fotosíntesis?','Proceso por el que las plantas producen alimento usando luz, agua y dióxido de carbono.'],
      ['¿Qué es la idea principal?','La información más importante que comunica un texto.']
    ];

    // Lee TXT, PDF e imágenes desde el bucket privado usando una URL firmada de corta duración.
    // El texto se extrae en el navegador; nunca se envía el archivo binario a Gemini.
    async function readSelectedMaterialText(material, onStatus = () => {}) {
      const { data: signed, error: signedErr } = await supabase.storage
        .from('materiales')
        .createSignedUrl(material.ruta_archivo, 120);
      if (signedErr) throw signedErr;

      const fileResponse = await fetch(signed.signedUrl);
      if (!fileResponse.ok) throw new Error('No se pudo descargar el material privado seleccionado.');

      const isPdf = material.tipo_mime === 'application/pdf' || /\.pdf$/i.test(material.nombre || '');
      if (isPdf) {
        const pdfjs = await import('https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.min.mjs');
        pdfjs.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.worker.min.mjs';
        const pdfBytes = new Uint8Array(await fileResponse.arrayBuffer());
        const pdf = await pdfjs.getDocument({ data: pdfBytes }).promise;
        if (pdf.numPages > 200) throw new Error('Este PDF tiene más de 200 páginas. Divide el documento para procesarlo.');

        const pages = [];
        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
          const page = await pdf.getPage(pageNumber);
          const content = await page.getTextContent();
          const pageText = content.items.map(item => {
            if (typeof item.str !== 'string') return '';
            return item.str + (item.hasEOL ? '\n' : ' ');
          }).join('').replace(/[ \t]+\n/g, '\n').trim();
          if (pageText) pages.push(`--- Página ${pageNumber} ---\n${pageText}`);
        }
        const extracted = pages.join('\n\n').trim();
        if (!extracted) throw new Error('No se encontró texto seleccionable en este PDF. Puede ser un documento escaneado; la lectura con OCR se implementará en la siguiente etapa.');
        return extracted;
      }

      if (material.tipo_mime === 'text/plain') {
        const text = await fileResponse.text();
        if (!text.trim()) throw new Error('El material seleccionado está vacío.');
        return text;
      }

      // Extrae texto de documentos Word modernos (.docx) en el navegador.
      // Los archivos .doc antiguos usan un formato binario distinto y requieren conversión a .docx.
      const isDocx = material.tipo_mime === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' || /\.docx$/i.test(material.nombre || '');
      const isLegacyDoc = material.tipo_mime === 'application/msword' || /\.doc$/i.test(material.nombre || '');
      if (isDocx) {
        onStatus('Preparando la lectura del documento Word…');
        if (!window.mammoth || typeof window.mammoth.extractRawText !== 'function') {
          await new Promise((resolve, reject) => {
            const existing = document.querySelector('script[data-aetris-mammoth]');
            if (existing) {
              existing.addEventListener('load', resolve, { once: true });
              existing.addEventListener('error', () => reject(new Error('No se pudo cargar el lector de Word. Comprueba tu conexión a internet e inténtalo otra vez.')), { once: true });
              if (window.mammoth && typeof window.mammoth.extractRawText === 'function') resolve();
              return;
            }
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js';
            script.async = true;
            script.dataset.aetrisMammoth = 'true';
            script.onload = resolve;
            script.onerror = () => reject(new Error('No se pudo cargar el lector de Word. Comprueba tu conexión a internet e inténtalo otra vez.'));
            document.head.appendChild(script);
          });
        }
        if (!window.mammoth || typeof window.mammoth.extractRawText !== 'function') {
          throw new Error('El lector de Word no está disponible. Recarga Aetris e inténtalo nuevamente.');
        }
        onStatus('Extrayendo el texto del documento Word…');
        const docxBuffer = await fileResponse.arrayBuffer();
        const wordResult = await window.mammoth.extractRawText({ arrayBuffer: docxBuffer });
        const extracted = (wordResult.value || '').trim();
        if (!extracted) throw new Error('No se encontró texto en este documento Word. Comprueba que tenga contenido escrito.');
        return extracted;
      }
      if (isLegacyDoc) {
        throw new Error('Este archivo es de formato Word antiguo (.doc). Ábrelo en Word o Google Docs y guárdalo como .docx; después vuelve a subirlo a Aetris.');
      }

      // Extrae el texto de presentaciones PowerPoint modernas (.pptx) en el navegador.
      // Se leen los XML de las diapositivas en orden; no se envía el archivo binario a Gemini.
      const isPptx = material.tipo_mime === 'application/vnd.openxmlformats-officedocument.presentationml.presentation' || /\.pptx$/i.test(material.nombre || '');
      const isLegacyPpt = material.tipo_mime === 'application/vnd.ms-powerpoint' || /\.ppt$/i.test(material.nombre || '');
      if (isPptx) {
        onStatus('Preparando la lectura de PowerPoint…');
        if (!window.JSZip || typeof window.JSZip.loadAsync !== 'function') {
          await new Promise((resolve, reject) => {
            const existing = document.querySelector('script[data-aetris-jszip]');
            if (existing) {
              existing.addEventListener('load', resolve, { once: true });
              existing.addEventListener('error', () => reject(new Error('No se pudo cargar el lector de PowerPoint. Comprueba tu conexión a internet e inténtalo otra vez.')), { once: true });
              if (window.JSZip && typeof window.JSZip.loadAsync === 'function') resolve();
              return;
            }
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js';
            script.async = true;
            script.dataset.aetrisJszip = 'true';
            script.onload = resolve;
            script.onerror = () => reject(new Error('No se pudo cargar el lector de PowerPoint. Comprueba tu conexión a internet e inténtalo otra vez.'));
            document.head.appendChild(script);
          });
        }
        if (!window.JSZip || typeof window.JSZip.loadAsync !== 'function') {
          throw new Error('El lector de PowerPoint no está disponible. Recarga Aetris e inténtalo nuevamente.');
        }
        onStatus('Extrayendo el texto de las diapositivas…');
        const pptxBuffer = await fileResponse.arrayBuffer();
        const archive = await window.JSZip.loadAsync(pptxBuffer);
        const slideFiles = Object.keys(archive.files)
          .filter(name => /^ppt\/slides\/slide\d+\.xml$/i.test(name))
          .sort((a, b) => Number(a.match(/slide(\d+)\.xml$/i)[1]) - Number(b.match(/slide(\d+)\.xml$/i)[1]));
        if (!slideFiles.length) throw new Error('No se encontraron diapositivas con contenido en esta presentación.');
        if (slideFiles.length > 200) throw new Error('Esta presentación tiene más de 200 diapositivas. Divide el archivo para procesarlo.');
        const slideTexts = [];
        for (let i = 0; i < slideFiles.length; i++) {
          const xml = await archive.files[slideFiles[i]].async('text');
          const xmlDoc = new DOMParser().parseFromString(xml, 'application/xml');
          if (xmlDoc.querySelector('parsererror')) continue;
          const parts = Array.from(xmlDoc.getElementsByTagNameNS('*', 't'))
            .map(node => (node.textContent || '').trim())
            .filter(Boolean);
          if (parts.length) slideTexts.push(`--- Diapositiva ${i + 1} ---\n${parts.join(' ')}`);
        }
        const extracted = slideTexts.join('\n\n').trim();
        if (!extracted) throw new Error('No se encontró texto legible en las diapositivas. Comprueba que la presentación contenga texto y no solo imágenes.');
        return extracted;
      }
      if (isLegacyPpt) {
        throw new Error('Este archivo es de formato PowerPoint antiguo (.ppt). Ábrelo en PowerPoint o Google Slides y guárdalo como .pptx; después vuelve a subirlo a Aetris.');
      }

      const isImage = (material.tipo_mime || '').startsWith('image/') || /\.(jpe?g|png|webp|gif)$/i.test(material.nombre || '');
      if (isImage) {
        onStatus('Preparando el reconocimiento de texto de la imagen…');
        const imageBlob = await fileResponse.blob();
        let worker;
        try {
          // Carga la compilación de navegador (UMD) y usa la API global Tesseract.
          // Evita el error de exportación createWorker del bundle ESM en algunos navegadores móviles.
          if (!window.Tesseract || typeof window.Tesseract.createWorker !== 'function') {
            await new Promise((resolve, reject) => {
              const existing = document.querySelector('script[data-aetris-tesseract]');
              if (existing) {
                existing.addEventListener('load', resolve, { once: true });
                existing.addEventListener('error', () => reject(new Error('No se pudo cargar el motor OCR. Comprueba tu conexión a internet e inténtalo otra vez.')), { once: true });
                if (window.Tesseract && typeof window.Tesseract.createWorker === 'function') resolve();
                return;
              }
              const script = document.createElement('script');
              script.src = 'https://cdn.jsdelivr.net/npm/tesseract.js@7.0.0/dist/tesseract.min.js';
              script.async = true;
              script.dataset.aetrisTesseract = 'true';
              script.onload = resolve;
              script.onerror = () => reject(new Error('No se pudo cargar el motor OCR. Comprueba tu conexión a internet e inténtalo otra vez.'));
              document.head.appendChild(script);
            });
          }
          const createWorker = window.Tesseract && window.Tesseract.createWorker;
          if (typeof createWorker !== 'function') throw new Error('El motor OCR se cargó, pero no está disponible. Recarga Aetris e inténtalo nuevamente.');
          onStatus('Reconociendo el texto de la imagen. Esto puede tardar un poco la primera vez…');
          worker = await createWorker('spa');
          const recognition = await worker.recognize(imageBlob);
          const extracted = (recognition.data.text || '').trim();
          if (!extracted) throw new Error('No se pudo reconocer texto. Prueba con una foto más clara, bien iluminada y enfocada.');
          return extracted;
        } finally {
          if (worker) await worker.terminate();
        }
      }

      // Procesa videos extrayendo fotogramas representativos y reconociendo el texto visible.
      // Esta primera etapa analiza títulos, diapositivas y subtítulos en pantalla; no transcribe el audio.
      const isVideo = (material.tipo_mime || '').startsWith('video/') || /\.(mp4|webm|mov)$/i.test(material.nombre || '');
      if (isVideo) {
        onStatus('Preparando el video para analizar sus imágenes…');
        const videoBlob = await fileResponse.blob();
        const videoUrl = URL.createObjectURL(videoBlob);
        const video = document.createElement('video');
        video.preload = 'metadata';
        video.muted = true;
        video.playsInline = true;
        video.src = videoUrl;
        try {
          await new Promise((resolve, reject) => {
            const timeout = setTimeout(() => reject(new Error('El video tardó demasiado en abrirse. Comprueba que sea MP4 o WebM compatible.')), 25000);
            video.onloadedmetadata = () => { clearTimeout(timeout); resolve(); };
            video.onerror = () => { clearTimeout(timeout); reject(new Error('No se pudo leer este video. Prueba con un archivo MP4 o WebM compatible.')); };
          });
          if (!Number.isFinite(video.duration) || video.duration <= 0) {
            throw new Error('No se pudo identificar la duración del video.');
          }
          if (video.duration > 3600) {
            throw new Error('Por ahora Aetris procesa videos de hasta 60 minutos. Recorta el video y vuelve a subirlo.');
          }

          // Reutiliza el motor OCR que ya funciona para las imágenes.
          if (!window.Tesseract || typeof window.Tesseract.createWorker !== 'function') {
            await new Promise((resolve, reject) => {
              const existing = document.querySelector('script[data-aetris-tesseract]');
              if (existing) {
                existing.addEventListener('load', resolve, { once: true });
                existing.addEventListener('error', () => reject(new Error('No se pudo cargar el motor de lectura de video. Comprueba tu conexión.')), { once: true });
                if (window.Tesseract && typeof window.Tesseract.createWorker === 'function') resolve();
                return;
              }
              const script = document.createElement('script');
              script.src = 'https://cdn.jsdelivr.net/npm/tesseract.js@7.0.0/dist/tesseract.min.js';
              script.async = true;
              script.dataset.aetrisTesseract = 'true';
              script.onload = resolve;
              script.onerror = () => reject(new Error('No se pudo cargar el motor de lectura de video. Comprueba tu conexión.'));
              document.head.appendChild(script);
            });
          }
          const createWorker = window.Tesseract && window.Tesseract.createWorker;
          if (typeof createWorker !== 'function') throw new Error('El motor OCR no está disponible. Recarga Aetris e inténtalo nuevamente.');

          const worker = await createWorker('spa');
          try {
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d', { willReadFrequently: true });
            if (!context) throw new Error('No se pudo preparar el lector de fotogramas en este navegador.');
            const scale = Math.min(1, 1280 / (video.videoWidth || 1280));
            canvas.width = Math.max(1, Math.round((video.videoWidth || 640) * scale));
            canvas.height = Math.max(1, Math.round((video.videoHeight || 360) * scale));

            // Máximo 12 fotogramas distribuidos a lo largo del video para cuidar el rendimiento del celular.
            const frameCount = Math.min(12, Math.max(2, Math.ceil(video.duration / 30)));
            const frameTexts = [];
            for (let i = 0; i < frameCount; i++) {
              const timestamp = frameCount === 1 ? 0 : (video.duration * i / (frameCount - 1));
              onStatus(`Analizando fotograma ${i + 1} de ${frameCount}…`);
              await new Promise((resolve, reject) => {
                const targetTime = Math.min(timestamp, Math.max(0, video.duration - 0.1));
                if (Math.abs(video.currentTime - targetTime) < 0.01 && video.readyState >= 2) {
                  resolve();
                  return;
                }
                const timeout = setTimeout(() => {
                  video.removeEventListener('seeked', done);
                  reject(new Error('El video no pudo avanzar al siguiente fotograma. Prueba con otro archivo.'));
                }, 12000);
                const done = () => { clearTimeout(timeout); resolve(); };
                video.addEventListener('seeked', done, { once: true });
                video.currentTime = targetTime;
              });
              context.drawImage(video, 0, 0, canvas.width, canvas.height);
              const result = await worker.recognize(canvas);
              const frameText = (result.data.text || '').trim();
              if (frameText) {
                const minutes = Math.floor(timestamp / 60);
                const seconds = Math.floor(timestamp % 60).toString().padStart(2, '0');
                frameTexts.push(`--- Fotograma ${i + 1} (${minutes}:${seconds}) ---\n${frameText}`);
              }
            }
            const extracted = frameTexts.join('\n\n').trim();
            if (!extracted) {
              throw new Error('No se encontró texto visible en los fotogramas. Esta versión reconoce títulos, diapositivas y subtítulos en pantalla, pero todavía no transcribe las voces del video.');
            }
            return extracted;
          } finally {
            await worker.terminate();
          }
        } finally {
          video.pause();
          video.removeAttribute('src');
          video.load();
          URL.revokeObjectURL(videoUrl);
        }
      }

      throw new Error('Este formato todavía no está habilitado para lectura con IA. Por ahora puedes usar TXT, PDF con texto seleccionable, imágenes, documentos Word DOCX y presentaciones PowerPoint PPTX.');
    }

    async function openStudyTool(tool) {
      if (!selectedMaterial) {
        alert('Primero selecciona un material en “Mis materiales”.');
        return;
      }
      workspace.hidden = false;
      workspace.innerHTML = `${workspaceHeader('Preparando tu material')}<p id="ai-status">Leyendo el material seleccionado…</p><div id="ai-result" style="white-space:pre-wrap;line-height:1.7"></div>`;
      bindWorkspaceClose();
      workspace.scrollIntoView({ behavior: 'smooth', block: 'start' });

      try {
        const mode = AI_MODE_BY_TOOL[tool];
        if (!mode) throw new Error('Esta herramienta todavía no está conectada a la IA.');

        const { data: sessionData, error: sessionError } = await supabase.auth.getSession();
        if (sessionError) throw sessionError;
        if (!sessionData.session) throw new Error('Tu sesión terminó. Vuelve a iniciar sesión.');

        const materialText = await readSelectedMaterialText(selectedMaterial, message => {
          const status = document.getElementById('ai-status');
          if (status) status.textContent = message;
        });
        if (!materialText.trim()) throw new Error('No se pudo extraer texto del material seleccionado.');
        if (materialText.length > 30000) throw new Error('El texto extraído supera el límite actual de 30 000 caracteres. Divide el PDF o los apuntes en materiales más pequeños.');

        const response = await fetch(AI_FUNCTION_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionData.session.access_token}`,
            'apikey': SUPABASE_PUBLISHABLE_KEY
          },
          body: JSON.stringify({ text: materialText, mode })
        });

        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          if (response.status === 404) throw new Error('No se encontró la función generar-estudio. Verifica que esté desplegada en este proyecto de Supabase.');
          if (response.status === 401 || response.status === 403) throw new Error('Tu sesión no fue aceptada. Cierra sesión y vuelve a ingresar.');
          throw new Error(result.error || result.message || 'No se pudo procesar el material.');
        }

        const generatedText = result.result || result.text || result.output;
        if (!generatedText) throw new Error('La función respondió, pero no devolvió el contenido esperado.');
        document.getElementById('ai-status').textContent = 'Contenido generado a partir de: ' + selectedMaterial.nombre;
        document.getElementById('ai-result').textContent = generatedText;

        // Guarda una copia del resultado para que el estudiante pueda consultarlo después.
        const history = readLocal('history').filter(item => item && typeof item === 'object');
        history.unshift({
          id: (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : `h_${Date.now()}_${Math.random().toString(16).slice(2)}`,
          tool,
          materialName: selectedMaterial.nombre,
          createdAt: new Date().toISOString(),
          content: generatedText.slice(0, 12000),
          truncated: generatedText.length > 12000
        });
        writeLocal('history', history.slice(0, 25));
      } catch (error) {
        const status = document.getElementById('ai-status');
        if (status) status.textContent = 'No se pudo generar el contenido: ' + error.message;
      }
    }
    document.querySelectorAll('.tool-card[data-tool]').forEach(card => {
      card.addEventListener('click', () => openStudyTool(card.dataset.tool));
      card.addEventListener('keydown', e => { if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openStudyTool(card.dataset.tool); } });
    });
    function workspaceHeader(title) {
      return `<div class="workspace-top"><h2>${title}</h2><button class="secondary-button" id="close-workspace" type="button">Cerrar</button></div>`;
    }
    function bindWorkspaceClose() {
      document.getElementById('close-workspace')?.addEventListener('click', () => { workspace.hidden = true; workspace.replaceChildren(); });
    }
    function renderQuestion() {
      if (questionIndex >= activeQuestions.length) {
        const pct = Math.round(questionScore / activeQuestions.length * 100);
        workspace.innerHTML = `${workspaceHeader(quizMode === 'exam' ? 'Resultado del examen' : 'Resultado del quiz')}
          <div class="result-score">${questionScore} de ${activeQuestions.length}</div>
          <p>Obtuviste ${pct}%. ${pct >= 70 ? '¡Buen trabajo!' : 'Sigue practicando, puedes mejorar!'}</p>
          <button class="primary-button" id="retry-quiz">Volver a practicar</button>`;
        bindWorkspaceClose();
        document.getElementById('retry-quiz').addEventListener('click', () => openStudyTool(quizMode));
        return;
      }
      const item = activeQuestions[questionIndex];
      const title = quizMode === 'exam' ? 'Examen de prueba' : 'Quiz';
      workspace.innerHTML = `${workspaceHeader(title)}
        <div><small>Pregunta ${questionIndex+1} de ${activeQuestions.length}</small></div>
        <div class="progress-track"><div class="progress-fill" style="width:${questionIndex/activeQuestions.length*100}%"></div></div>
        <h3>${item.q}</h3><div class="question-options">${item.a.map((a,i)=>`<button class="answer-option" data-answer="${i}">${String.fromCharCode(65+i)}. ${a}</button>`).join('')}</div>
        <p id="answer-feedback" aria-live="polite"></p>
        <button class="primary-button" id="next-question" disabled>${questionIndex === activeQuestions.length-1 ? 'Ver resultado' : 'Siguiente'}</button>`;
      bindWorkspaceClose();
      let answered = false;
      document.querySelectorAll('#study-workspace [data-answer]').forEach(btn => btn.addEventListener('click', () => {
        if(answered) return; answered = true;
        const selected = Number(btn.dataset.answer), correct = selected === item.c;
        if(correct) questionScore++;
        document.querySelectorAll('#study-workspace [data-answer]').forEach((option,i) => {
          option.disabled = true;
          if(i === item.c) option.classList.add('correct');
          if(i === selected && !correct) option.classList.add('incorrect');
        });
        document.getElementById('answer-feedback').textContent = (correct ? '¡Correcto! ' : 'No es correcto. ') + item.e;
        document.getElementById('next-question').disabled = false;
      }));
      document.getElementById('next-question').addEventListener('click', () => { questionIndex++; renderQuestion(); });
    }
    function renderFlashcard() {
      const pair = flashcards[cardIndex];
      workspace.innerHTML = `${workspaceHeader('Tarjetas didácticas')}
        <p>Tarjeta ${cardIndex+1} de ${flashcards.length}. Toca la tarjeta para girarla.</p>
        <div class="flashcard" id="flashcard">${cardFlipped ? pair[1] : pair[0]}<small>${cardFlipped ? 'Respuesta' : 'Pregunta'} · Toca para girar</small></div>
        <div class="data-actions" style="margin-top:14px"><button class="secondary-button" id="card-prev">Anterior</button><button class="primary-button" id="card-next">Siguiente</button></div>`;
      bindWorkspaceClose();
      document.getElementById('flashcard').addEventListener('click', () => { cardFlipped = !cardFlipped; renderFlashcard(); });
      document.getElementById('card-prev').addEventListener('click', () => { cardIndex=(cardIndex-1+flashcards.length)%flashcards.length; cardFlipped=false; renderFlashcard(); });
      document.getElementById('card-next').addEventListener('click', () => { cardIndex=(cardIndex+1)%flashcards.length; cardFlipped=false; renderFlashcard(); });
    }

    function renderGoals() {
      const list=document.getElementById('goals-list'), goals=readLocal('goals'); list.replaceChildren();
      const completed=goals.filter(g=>g.done || Number(g.progress||0)>=100).length;
      const percent=goals.length ? Math.round(completed/goals.length*100) : 0;
      document.getElementById('goals-overview').innerHTML = `<div class="goals-overview-top"><div><strong>Tu progreso</strong><p>${completed} de ${goals.length} metas completadas</p></div><strong>${percent}%</strong></div><div class="progress-track"><div class="progress-fill" style="width:${percent}%"></div></div><p>${goals.length ? (completed===goals.length ? '¡Excelente! Has cumplido todas tus metas.' : 'Cada pequeño avance cuenta. Sigue a tu propio ritmo.') : 'Cuando agregues metas, aquí podrás ver cómo avanzas.'}</p>`;
      if(!goals.length){ list.innerHTML='<div class="empty-state"><strong>Aún no has agregado metas</strong><p>Elige una idea de arriba o agrega un objetivo que quieras alcanzar.</p></div>'; return; }
      goals.forEach(g=>{
        const progress=Math.max(0,Math.min(100,Number(g.progress ?? (g.done?100:0))));
        const el=document.createElement('article'); el.className='data-card'+(g.done?' done':'');
        const main=document.createElement('div'); main.className='goal-card-main';
        const info=document.createElement('div'); info.innerHTML=`<h3></h3><p></p><small></small>`;
        info.querySelector('h3').textContent=g.title; info.querySelector('p').textContent=g.detail||'';
        info.querySelector('small').textContent=g.date ? 'Fecha límite: '+g.date : 'Sin fecha límite';
        const progressBox=document.createElement('div'); progressBox.className='goal-progress';
        const progressLabel=document.createElement('label');
        const progressName=document.createElement('span'); progressName.textContent='Mi avance';
        const progressValue=document.createElement('strong'); progressValue.textContent=progress+'%';
        progressLabel.append(progressName,progressValue);
